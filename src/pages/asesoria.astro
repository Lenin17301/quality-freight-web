---
// src/pages/asesoria.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
    lang="es" 
    title="Asesoría en Comercio Internacional | Quality Freight Service" 
    description="Asesoría especializada en importación, exportación, cumplimiento normativo y optimización de costos logísticos." 
>
    
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden pb-24">
        
        <!-- HERO ASESORÍA -->
        <section class="pt-32 pb-16 px-6 lg:pt-40 max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-16">
                <!-- Textos e Iconos -->
                <div class="w-full lg:w-1/2">
                    <h1 class="text-4xl md:text-5xl font-light text-[#002845] mb-6 leading-tight">
                        Asesoría especializada en <span class="font-black text-[#BAD700]">comercio internacional</span>
                    </h1>
                    <p class="text-gray-500 mb-10 leading-relaxed text-sm md:text-base">
                        Te acompañamos en cada paso de tu operación internacional, brindándote asesoría personalizada para que tomes decisiones seguras y eficientes. Maximizamos la rentabilidad de tu cadena de suministro.
                    </p>

                    <!-- Beneficios (3 columnas) -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Asesoría<br/>Personalizada</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">Soluciones adaptadas a tu negocio.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Cumplimiento<br/>Normativo</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">Te guiamos en requisitos y regulaciones.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Optimización<br/>de Costos</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">Estrategias para mejorar tus operaciones.</p>
                        </div>
                    </div>
                </div>

                <!-- Imagen Derecha -->
                <div class="w-full lg:w-1/2 relative">
                    <div class="absolute -top-10 -right-10 w-64 h-64 bg-[#E8ECEE] rounded-full z-0"></div>
                    <img src="https://images.pexels.com/photos/7734158/pexels-photo-7734158.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Consultoría Logística" class="relative z-10 w-full h-[400px] object-cover rounded-[3rem] shadow-2xl" />
                </div>
            </div>
        </section>

        <!-- SERVICIOS DE ASESORÍA (ZIG-ZAG) -->
        <section class="py-16 px-6 max-w-7xl mx-auto relative">
            <!-- Círculo decorativo izquierdo -->
            <div class="absolute top-1/2 -left-32 w-64 h-64 bg-[#BAD700] rounded-full opacity-20 -translate-y-1/2"></div>
            
            <h2 class="text-3xl md:text-5xl font-light text-[#002845] text-center mb-16 relative z-10">
                Nuestros Servicios de <span class="font-black text-[#BAD700]">Asesoría</span>
            </h2>

            <div class="space-y-6 relative z-10">
                <!-- Bloque 1 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Asesoría en Importación<br/>y Exportación</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Planificación estratégica de sus movimientos internacionales. Evaluamos la viabilidad de sus proyectos, identificamos oportunidades de mercado y estructuramos rutas eficientes para reducir tiempos y costos operativos.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Importación" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Bloque 2 -->
                <div class="flex flex-col md:flex-row-reverse gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Clasificación Arancelaria<br/>y Documentación</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Evite multas y retrasos en aduana. Nuestros expertos determinan los códigos arancelarios precisos para su mercancía y gestionan certificados de origen, permisos sanitarios y licencias especiales requeridas.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/7734739/pexels-photo-7734739.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Documentación" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Bloque 3 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Gestión de Logística<br/>Internacional</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Desarrollo de proyectos llave en mano (Door-to-Door). Coordinamos a todos los actores de la cadena: navieras, aerolíneas, transportistas terrestres y agentes aduanales, garantizando fluidez total.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Logística Global" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>
            </div>
        </section>

        <!-- FORMULARIO DE COTIZACIÓN -->
        <section class="py-16 px-6">
            <div class="max-w-4xl mx-auto bg-white rounded-[3rem] p-8 md:p-12 shadow-[0_20px_50px_rgba(0,40,69,0.1)] border border-stone-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#BAD700] rounded-bl-[100%] opacity-20"></div>
                
                <div class="text-center mb-10 relative z-10">
                    <h2 class="text-3xl font-black text-[#002845] mb-2">Solicitar Cotización</h2>
                    <p class="text-gray-500 text-sm">Complete el formulario y le contactaremos con una propuesta a medida.</p>
                </div>

                <form class="space-y-6 relative z-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Nombre y Apellido</label>
                            <input type="text" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Empresa</label>
                            <input type="text" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Correo Corporativo</label>
                            <input type="email" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Teléfono</label>
                            <input type="tel" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Tipo de Transporte</label>
                            <select class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none appearance-none" required>
                                <option value="" disabled selected>Seleccione...</option>
                                <option value="maritimo">Marítimo</option>
                                <option value="aereo">Aéreo</option>
                                <option value="terrestre">Terrestre</option>
                                <option value="aduanas">Agenciamiento Aduanal</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Tipo de Carga</label>
                            <select class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none appearance-none" required>
                                <option value="" disabled selected>Seleccione...</option>
                                <option value="fcl">Contenedor Completo (FCL)</option>
                                <option value="lcl">Carga Consolidada (LCL)</option>
                                <option value="suelta">Carga Suelta / Breakbulk</option>
                                <option value="peligrosa">Carga Peligrosa (IMO)</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Detalles del Envío</label>
                        <textarea rows="4" placeholder="Describa volumen, dimensiones, puertos de origen y destino..." class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none resize-none transition-shadow" required></textarea>
                    </div>
                    <div class="flex items-start gap-3">
                        <input type="checkbox" id="terms" class="mt-1 accent-[#BAD700] w-4 h-4 cursor-pointer" required />
                        <label for="terms" class="text-xs text-gray-500 cursor-pointer">Acepto que mis datos sean almacenados para contacto comercial y envío de cotizaciones.</label>
                    </div>
                    
                    <button type="submit" class="w-full bg-[#002845] text-white font-bold text-lg py-4 rounded-xl hover:bg-[#001c30] transition-colors shadow-lg mt-4">
                        Enviar Solicitud
                    </button>
                </form>
            </div>
        </section>

    </main>
    
    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>