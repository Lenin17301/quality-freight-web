---
// src/pages/servicios/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
    title="Servicios Logísticos | Quality Freight Service" 
    description="Explora nuestros servicios de carga aérea, marítima, terrestre y agenciamiento aduanal. Soluciones integrales para su empresa." 
    lang="es"
>
    
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden pb-24 pt-32">
        <section class="max-w-7xl mx-auto px-6">
            <h1 class="text-5xl font-light text-[#002845] mb-16 text-center">
                Nuestros <span class="font-black text-[#BAD700]">Servicios</span>
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Tarjeta Servicio 1 -->
                <a href="/servicios/carga-maritima" class="group relative bg-[#002845] rounded-4xl h-80 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">
                    <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Carga Marítima" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out opacity-80" />
                    <div class="absolute inset-0 bg-linear-to-t from-[#002845]/90 via-[#002845]/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-8 w-full transform group-hover:-translate-y-2 transition-transform duration-500">
                        <h3 class="text-3xl font-black text-white mb-2">Carga Marítima</h3>
                        <p class="text-sm text-stone-300">Soluciones FCL, LCL y carga sobredimensionada a nivel mundial.</p>
                    </div>
                </a>
                
                <!-- Tarjeta Servicio 2 -->
                <a href="/servicios/carga-aerea" class="group relative bg-[#002845] rounded-4xl h-80 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">
                    <img src="https://images.pexels.com/photos/6169046/pexels-photo-6169046.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Carga Aérea" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out opacity-80" />
                    <div class="absolute inset-0 bg-linear-to-t from-[#002845]/90 via-[#002845]/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-8 w-full transform group-hover:-translate-y-2 transition-transform duration-500">
                        <h3 class="text-3xl font-black text-white mb-2">Carga Aérea</h3>
                        <p class="text-sm text-stone-300">Transporte expedito para mercancía crítica y prioritaria.</p>
                    </div>
                </a>

                <!-- Tarjeta Servicio 3 -->
                <a href="/servicios/carga-terrestre" class="group relative bg-[#002845] rounded-4xl h-80 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">
                    <img src="https://images.pexels.com/photos/2226458/pexels-photo-2226458.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Carga Terrestre" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out opacity-80" />
                    <div class="absolute inset-0 bg-linear-to-t from-[#002845]/90 via-[#002845]/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-8 w-full transform group-hover:-translate-y-2 transition-transform duration-500">
                        <h3 class="text-3xl font-black text-white mb-2">Carga Terrestre</h3>
                        <p class="text-sm text-stone-300">Logística nacional y transfronteriza con monitoreo 24/7.</p>
                    </div>
                </a>

                <!-- Tarjeta Servicio 4 -->
                <a href="/servicios/agentes-de-aduana" class="group relative bg-[#002845] rounded-4xl h-80 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">
                    <img src="https://images.pexels.com/photos/2800121/pexels-photo-2800121.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Agentes de Aduana" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out opacity-80" />
                    <div class="absolute inset-0 bg-linear-to-t from-[#002845]/90 via-[#002845]/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 p-8 w-full transform group-hover:-translate-y-2 transition-transform duration-500">
                        <h3 class="text-3xl font-black text-white mb-2">Agentes de Aduana</h3>
                        <p class="text-sm text-stone-300">Despacho eficiente y cumplimiento normativo garantizado.</p>
                    </div>
                </a>
            </div>
        </section>
    </main>

    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>