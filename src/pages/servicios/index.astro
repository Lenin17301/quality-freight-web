---
// src/pages/servicios/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
    title="Servicios Logísticos | Quality Freight Service" 
    description="Explora nuestros servicios de carga aérea, marítima, terrestre y agenciamiento aduanal. Soluciones integrales para su empresa." 
    lang="es"
>
    
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden pb-24 pt-32">
        <section class="max-w-7xl mx-auto px-6">
            <h1 class="text-5xl font-light text-[#002845] mb-16 text-center">
                Nuestros <span class="font-black text-[#BAD700]">Servicios</span>
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Tarjeta Servicio 1 -->
                <a href="/servicios/carga-maritima" class="group bg-[#E8ECEE] rounded-[2rem] p-8 hover:bg-[#002845] transition-colors duration-500 flex flex-col justify-between h-80">
                    <h3 class="text-3xl font-black text-[#002845] group-hover:text-white transition-colors">Carga Marítima</h3>
                    <p class="text-sm text-gray-500 group-hover:text-stone-300 transition-colors">Soluciones FCL, LCL y carga sobredimensionada a nivel mundial.</p>
                </a>
                <!-- Tarjeta Servicio 2 -->
                <a href="/servicios/carga-aerea" class="group bg-[#E8ECEE] rounded-[2rem] p-8 hover:bg-[#002845] transition-colors duration-500 flex flex-col justify-between h-80">
                    <h3 class="text-3xl font-black text-[#002845] group-hover:text-white transition-colors">Carga Aérea</h3>
                    <p class="text-sm text-gray-500 group-hover:text-stone-300 transition-colors">Transporte expedito para mercancía crítica y prioritaria.</p>
                </a>
                <!-- Tarjeta Servicio 3 -->
                <a href="/servicios/carga-terrestre" class="group bg-[#E8ECEE] rounded-[2rem] p-8 hover:bg-[#002845] transition-colors duration-500 flex flex-col justify-between h-80">
                    <h3 class="text-3xl font-black text-[#002845] group-hover:text-white transition-colors">Carga Terrestre</h3>
                    <p class="text-sm text-gray-500 group-hover:text-stone-300 transition-colors">Logística nacional y transfronteriza con monitoreo 24/7.</p>
                </a>
                <!-- Tarjeta Servicio 4 -->
                <a href="/servicios/agentes-de-aduana" class="group bg-[#E8ECEE] rounded-[2rem] p-8 hover:bg-[#002845] transition-colors duration-500 flex flex-col justify-between h-80">
                    <h3 class="text-3xl font-black text-[#002845] group-hover:text-white transition-colors">Agentes de Aduana</h3>
                    <p class="text-sm text-gray-500 group-hover:text-stone-300 transition-colors">Despacho eficiente y cumplimiento normativo garantizado.</p>
                </a>
            </div>
        </section>
    </main>

    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>