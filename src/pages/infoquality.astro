---
// src/pages/infoquality.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import { Image } from 'astro:assets';
import bgHero from '../assets/images/logistica-y-rastreo-carga.png';

const containers = [
    {
        name: "20' Dry Van (Estándar)",
        tag: "Carga Seca",
        internalDim: "5.90 m × 2.35 m × 2.39 m",
        doorDim: "2.34 m × 2.28 m",
        capacity: "33.2 m³",
        maxPayload: "28,200 kg",
        tare: "2,280 kg",
        idealFor: "Carga general paletizada, cajas, maquinaria compacta y mercancía seca."
    },
    {
        name: "40' Dry Van (Estándar)",
        tag: "Alto Volumen",
        internalDim: "12.03 m × 2.35 m × 2.39 m",
        doorDim: "2.34 m × 2.28 m",
        capacity: "67.7 m³",
        maxPayload: "26,700 kg",
        tare: "3,780 kg",
        idealFor: "Grandes volúmenes de mercancía seca, textiles, muebles y carga consolidada."
    },
    {
        name: "40' High Cube (HC)",
        tag: "Extra Altura",
        internalDim: "12.03 m × 2.35 m × 2.69 m",
        doorDim: "2.34 m × 2.58 m",
        capacity: "76.3 m³",
        maxPayload: "26,580 kg",
        tare: "3,900 kg",
        idealFor: "Carga ligera de gran altura (+30 cm adicionales) y mercancía voluminosa."
    },
    {
        name: "20' / 40' Refrigerado (Reefer)",
        tag: "Temperatura Controlada",
        internalDim: "5.44 m / 11.56 m × 2.29 m × 2.27 m",
        doorDim: "2.28 m × 2.26 m",
        capacity: "28.3 m³ / 59.3 m³",
        maxPayload: "27,400 kg / 29,500 kg",
        tare: "3,080 kg / 4,500 kg",
        idealFor: "Alimentos perecederos, productos farmacéuticos y carga sensible a temperatura (-25 °C a +25 °C)."
    },
    {
        name: "20' / 40' Open Top & Flat Rack",
        tag: "Sobredimensionada",
        internalDim: "Techo abierto / Sin paredes laterales",
        doorDim: "Carga superior o lateral con grúa",
        capacity: "Variable según proyecto",
        maxPayload: "Hasta 40,000 kg (Flat Rack)",
        tare: "2,360 kg – 5,000 kg",
        idealFor: "Maquinaria pesada, vehículos, tuberías y piezas extrapesadas o fuera de medida."
    }
];

const incoterms = [
    { code: "EXW", name: "Ex Works", desc: "El vendedor entrega la mercancía en sus propias instalaciones; el comprador asume todos los costos y riesgos." },
    { code: "FOB", name: "Free On Board", desc: "El vendedor entrega la carga a bordo del buque en el puerto de origen designado." },
    { code: "CIF", name: "Cost, Insurance & Freight", desc: "El vendedor cubre costo, seguro y flete marítimo hasta el puerto de destino." },
    { code: "DDP", name: "Delivered Duty Paid", desc: "Entrega puerta a puerta con derechos aduaneros e impuestos pagados en destino." }
];

const schemaData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "InfoQuality | Consulta de Envíos y Herramientas Logísticas",
    "description": "Consulta el estatus de tu envío con código de guía y accede a especificaciones técnicas de contenedores marítimos, peso volumétrico e Incoterms.",
    "inLanguage": "es"
};
---

<BaseLayout 
    lang="es"
    title="InfoQuality | Estatus de Envíos y Herramientas Logísticas | Quality Freight Service" 
    description="Consulta la ubicación y estatus de tu carga con tu número de guía y revisa nuestras herramientas logísticas: medidas de contenedores, peso volumétrico e Incoterms."
>
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <main class="bg-white overflow-hidden min-h-screen">
        
        <!-- HERO + FORMULARIO INFOQUALITY -->
        <section class="relative bg-[#002845] pt-32 pb-24 px-6 lg:pt-40 lg:pb-32 overflow-hidden">
            <!-- Imagen de fondo optimizada -->
            <div class="absolute inset-0 z-0">
                <Image 
                    src={bgHero} 
                    alt="Operaciones logísticas y seguimiento de carga Quality Freight Service" 
                    class="w-full h-full object-cover opacity-20 mix-blend-luminosity"
                    fetchpriority="high"
                    loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-b from-[#002845]/95 via-[#002845]/85 to-[#002845]"></div>
            </div>

            <div class="relative z-10 max-w-7xl mx-auto flex flex-col lg:flex-row items-start gap-12 lg:gap-16">
                
                <!-- Columna Izquierda: Presentación InfoQuality -->
                <div class="w-full lg:w-5/12 lg:sticky lg:top-32 text-left">
                    <nav aria-label="Breadcrumb" class="flex text-[10px] sm:text-xs font-black uppercase tracking-widest text-[#BAD700] mb-6 gap-2">
                        <a href="/" class="hover:text-white transition-colors">Inicio</a> <span>/</span>
                        <span class="text-white">InfoQuality</span>
                    </nav>

                    <div class="w-14 h-14 bg-[#BAD700] rounded-2xl flex items-center justify-center mb-6 shadow-lg">
                        <svg class="w-7 h-7 text-[#002845]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-light text-white mb-6 leading-[1.1]">
                        Info<span class="font-black text-[#BAD700]">Quality.</span>
                    </h1>
                    
                    <p class="text-gray-300 text-base md:text-lg font-light leading-relaxed mb-8">
                        Gestiona el seguimiento directo de tus operaciones internacionales. Completa el formulario con tu código de guía y nuestro equipo de operaciones te enviará el reporte actualizado de tu mercancía.
                    </p>

                    <div class="space-y-4 border-t border-white/10 pt-8">
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full bg-[#BAD700]/20 text-[#BAD700] flex items-center justify-center text-xs font-black">✓</span>
                            <span class="text-sm text-gray-200">Atención personalizada por ejecutivo de cuenta</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full bg-[#BAD700]/20 text-[#BAD700] flex items-center justify-center text-xs font-black">✓</span>
                            <span class="text-sm text-gray-200">Actualización directa a tu correo o WhatsApp</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full bg-[#BAD700]/20 text-[#BAD700] flex items-center justify-center text-xs font-black">✓</span>
                            <span class="text-sm text-gray-200">Guía técnica de contenedores y herramientas abajo</span>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Formulario Base Corto -->
                <div class="w-full lg:w-7/12">
                    <div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-[0_30px_60px_rgba(0,0,0,0.35)] border border-white/10">
                        <div class="mb-8 pb-6 border-b border-stone-100">
                            <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs block mb-2">Consulta de Envío</span>
                            <h2 class="text-2xl md:text-3xl font-light text-[#002845]">
                                Solicitar reporte de <span class="font-black">seguimiento</span>
                            </h2>
                        </div>

                    <form action="https://formsubmit.co/lceballos17301@gmail.com" method="POST" class="space-y-6">
                        <input type="hidden" name="_subject" value="Nueva consulta de seguimiento - InfoQuality" />
                        <input type="hidden" name="_template" value="table" />

                            <!-- 1. Número de guía o código de seguimiento (Obligatorio) -->
                            <div>
                                <label for="numero_guia" class="block text-sm font-bold text-[#002845] mb-1.5">
                                    1. Número de guía o código de seguimiento <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="numero_guia" 
                                    name="numero_guia" 
                                    required 
                                    aria-describedby="help_guia"
                                    placeholder="Ej. QFS-2026-88412"
                                    class="w-full p-4 bg-stone-50 rounded-2xl border border-stone-200/60 text-[#002845] outline-none focus:ring-2 focus:ring-[#002845] focus:bg-white transition-all"
                                />
                                <p id="help_guia" class="text-xs text-slate-500 mt-1.5">
                                    Ingresa el código que recibiste al confirmar tu envío.
                                </p>
                            </div>

                            <!-- 2. Nombre completo o razón social (Obligatorio) -->
                            <div>
                                <label for="nombre_empresa" class="block text-sm font-bold text-[#002845] mb-1.5">
                                    2. Nombre completo o razón social de la empresa <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="nombre_empresa" 
                                    name="nombre_empresa" 
                                    required 
                                    aria-describedby="help_nombre"
                                    placeholder="Ej. Inversiones Logísticas C.A. / Juan Pérez"
                                    class="w-full p-4 bg-stone-50 rounded-2xl border border-stone-200/60 text-[#002845] outline-none focus:ring-2 focus:ring-[#002845] focus:bg-white transition-all"
                                />
                                <p id="help_nombre" class="text-xs text-slate-500 mt-1.5">
                                    Nombre del remitente o destinatario registrado en el envío.
                                </p>
                            </div>

                            <!-- 3 y 4 en Grid: Correo (Obligatorio) y Teléfono/WhatsApp (Opcional) -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="email" class="block text-sm font-bold text-[#002845] mb-1.5">
                                        3. Correo electrónico <span class="text-red-500">*</span>
                                    </label>
                                    <input 
                                        type="email" 
                                        id="email" 
                                        name="email" 
                                        required 
                                        aria-describedby="help_email"
                                        placeholder="correo@empresa.com"
                                        class="w-full p-4 bg-stone-50 rounded-2xl border border-stone-200/60 text-[#002845] outline-none focus:ring-2 focus:ring-[#002845] focus:bg-white transition-all"
                                    />
                                    <p id="help_email" class="text-xs text-slate-500 mt-1.5">
                                        Aquí te enviaremos el reporte actualizado de tu pedido.
                                    </p>
                                </div>

                                <div>
                                    <label for="telefono" class="block text-sm font-bold text-[#002845] mb-1.5">
                                        4. Teléfono o WhatsApp de contacto <span class="text-xs font-normal text-slate-400">(Opcional)</span>
                                    </label>
                                    <input 
                                        type="tel" 
                                        id="telefono" 
                                        name="telefono" 
                                        aria-describedby="help_telefono"
                                        placeholder="+58 412 000 0000"
                                        class="w-full p-4 bg-stone-50 rounded-2xl border border-stone-200/60 text-[#002845] outline-none focus:ring-2 focus:ring-[#002845] focus:bg-white transition-all"
                                    />
                                    <p id="help_telefono" class="text-xs text-slate-500 mt-1.5">
                                        Para comunicarnos rápidamente en caso de alguna novedad con la entrega.
                                    </p>
                                </div>
                            </div>

                            <!-- 5. Selección múltiple (Opcional) -->
                            <fieldset class="pt-2">
                                <legend class="block text-sm font-bold text-[#002845] mb-3">
                                    5. ¿En qué podemos ayudarte respecto a tu envío? <span class="text-xs font-normal text-slate-400">(Opcional - Selección múltiple)</span>
                                </legend>
                                <div class="grid grid-cols-1 gap-3">
                                    <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 hover:bg-stone-100/80 border border-stone-200/60 cursor-pointer transition-colors">
                                        <input type="checkbox" name="motivo_consulta[]" value="Ubicacion actual y fecha estimada" class="mt-0.5 w-4 h-4 accent-[#002845] rounded" />
                                        <span class="text-sm text-slate-700">Saber la ubicación actual y fecha estimada de entrega.</span>
                                    </label>

                                    <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 hover:bg-stone-100/80 border border-stone-200/60 cursor-pointer transition-colors">
                                        <input type="checkbox" name="motivo_consulta[]" value="Reportar un retraso" class="mt-0.5 w-4 h-4 accent-[#002845] rounded" />
                                        <span class="text-sm text-slate-700">Reportar un retraso.</span>
                                    </label>

                                    <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 hover:bg-stone-100/80 border border-stone-200/60 cursor-pointer transition-colors">
                                        <input type="checkbox" name="motivo_consulta[]" value="Actualizar direccion o contacto" class="mt-0.5 w-4 h-4 accent-[#002845] rounded" />
                                        <span class="text-sm text-slate-700">Actualizar dirección o datos de contacto del destinatario.</span>
                                    </label>

                                    <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 hover:bg-stone-100/80 border border-stone-200/60 cursor-pointer transition-colors">
                                        <input type="checkbox" name="motivo_consulta[]" value="Otra consulta" class="mt-0.5 w-4 h-4 accent-[#002845] rounded" />
                                        <span class="text-sm text-slate-700">Otra consulta.</span>
                                    </label>
                                </div>
                            </fieldset>

                            <!-- 6. Comentarios o detalles adicionales (Opcional) -->
                            <div>
                                <label for="comentarios" class="block text-sm font-bold text-[#002845] mb-1.5">
                                    6. Comentarios o detalles adicionales <span class="text-xs font-normal text-slate-400">(Opcional)</span>
                                </label>
                                <textarea 
                                    id="comentarios" 
                                    name="comentarios" 
                                    rows="3" 
                                    aria-describedby="help_comentarios"
                                    placeholder="Indica detalles sobre tu carga, horarios o instrucciones especiales..."
                                    class="w-full p-4 bg-stone-50 rounded-2xl border border-stone-200/60 text-[#002845] outline-none resize-none focus:ring-2 focus:ring-[#002845] focus:bg-white transition-all"
                                ></textarea>
                                <p id="help_comentarios" class="text-xs text-slate-500 mt-1.5">
                                    Escribe cualquier observación importante sobre tu carga o el horario de recepción.
                                </p>
                            </div>

                            <button 
                                type="submit" 
                                class="w-full bg-[#002845] text-white font-black py-5 rounded-2xl hover:bg-[#BAD700] hover:text-[#002845] transition-all tracking-wide shadow-lg shadow-[#002845]/20 cursor-pointer"
                            >
                                Consultar estado del envío
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </section>

        <!-- SECCIÓN HERRAMIENTAS: ESPECIFICACIONES DE CONTENEDORES -->
        <section id="herramientas" class="py-24 px-6 bg-stone-50 border-t border-stone-200">
            <div class="max-w-7xl mx-auto">
                
                <!-- Encabezado de Herramientas -->
                <div class="max-w-3xl mb-16">
                    <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs block mb-3">
                        Herramientas Logísticas
                    </span>
                    <h2 class="text-3xl md:text-5xl font-light text-[#002845] leading-tight mb-6">
                        Especificaciones de <span class="font-black">Contenedores.</span>
                    </h2>
                    <p class="text-slate-600 text-lg font-light leading-relaxed">
                        Consulta las medidas internas, capacidad cúbica y peso máximo autorizado de los equipos marítimos estándar y especializados para planificar tu embarque con precisión.
                    </p>
                </div>

                <!-- Grid de Tarjetas de Contenedores -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
                    {containers.map((item) => (
                        <article class="bg-white rounded-3xl p-8 border border-stone-200/80 shadow-sm hover:shadow-[0_20px_50px_rgba(0,40,69,0.08)] transition-all duration-300 flex flex-col">
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <span class="bg-[#BAD700]/25 text-[#002845] text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">
                                    {item.tag}
                                </span>
                                <span class="text-xs font-bold text-slate-400">{item.capacity}</span>
                            </div>

                            <h3 class="text-2xl font-black text-[#002845] mb-6">
                                {item.name}
                            </h3>

                            <dl class="space-y-3 text-sm border-t border-stone-100 pt-5 mb-6 flex-grow">
                                <div class="flex justify-between gap-4">
                                    <dt class="text-slate-500">Dimensiones internas:</dt>
                                    <dd class="font-bold text-[#002845] text-right">{item.internalDim}</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt class="text-slate-500">Apertura de puerta:</dt>
                                    <dd class="font-bold text-[#002845] text-right">{item.doorDim}</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt class="text-slate-500">Capacidad cúbica:</dt>
                                    <dd class="font-bold text-[#002845] text-right">{item.capacity}</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt class="text-slate-500">Carga máxima (Payload):</dt>
                                    <dd class="font-bold text-[#002845] text-right">{item.maxPayload}</dd>
                                </div>
                                <div class="flex justify-between gap-4">
                                    <dt class="text-slate-500">Peso tara:</dt>
                                    <dd class="font-medium text-slate-600 text-right">{item.tare}</dd>
                                </div>
                            </dl>

                            <p class="text-xs text-slate-500 bg-stone-50 p-4 rounded-2xl leading-relaxed">
                                <strong class="text-[#002845]">Uso ideal:</strong> {item.idealFor}
                            </p>
                        </article>
                    ))}
                </div>

                <!-- Herramientas Complementarias: Peso Volumétrico e Incoterms -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
                    
                    <!-- Fórmulas de Peso Volumétrico -->
                    <div class="lg:col-span-5 bg-[#002845] text-white rounded-[2.5rem] p-8 md:p-10 flex flex-col justify-between">
                        <div>
                            <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs block mb-3">
                                Cálculo de Flete
                            </span>
                            <h3 class="text-2xl md:text-3xl font-light mb-4">
                                Peso <span class="font-black text-[#BAD700]">Volumétrico</span>
                            </h3>
                            <p class="text-gray-300 text-sm font-light leading-relaxed mb-8">
                                En el transporte internacional se factura el valor mayor entre el peso bruto real (kg) y el peso volumétrico calculado según las dimensiones del bulto:
                            </p>

                            <div class="space-y-4">
                                <div class="bg-white/10 rounded-2xl p-5 border border-white/10">
                                    <p class="text-xs uppercase tracking-wider text-[#BAD700] font-black mb-1">Carga Aérea (IATA)</p>
                                    <p class="font-mono text-sm text-white">
                                        (Largo × Ancho × Alto en cm) ÷ 6,000 = Kg Vol.
                                    </p>
                                </div>

                                <div class="bg-white/10 rounded-2xl p-5 border border-white/10">
                                    <p class="text-xs uppercase tracking-wider text-[#BAD700] font-black mb-1">Carga Marítima Consolidada (LCL)</p>
                                    <p class="font-mono text-sm text-white">
                                        1 Tonelada (1,000 kg) = 1 Metro Cúbico (1 m³)
                                    </p>
                                </div>

                                <div class="bg-white/10 rounded-2xl p-5 border border-white/10">
                                    <p class="text-xs uppercase tracking-wider text-[#BAD700] font-black mb-1">Carga Terrestre</p>
                                    <p class="font-mono text-sm text-white">
                                        (Largo × Ancho × Alto en cm) ÷ 3,000 = Kg Vol.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 pt-6 border-t border-white/10">
                            <a href="/servicios" class="inline-flex items-center gap-2 text-sm font-black text-[#BAD700] hover:underline">
                                Solicitar asesoría de cubicaje y cotización →
                            </a>
                        </div>
                    </div>

                    <!-- Guía Rápida de Incoterms -->
                    <div class="lg:col-span-7 bg-white rounded-[2.5rem] p-8 md:p-10 border border-stone-200/80">
                        <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs block mb-3">
                            Comercio Exterior
                        </span>
                        <h3 class="text-2xl md:text-3xl font-light text-[#002845] mb-4">
                            Guía rápida de <span class="font-black">Incoterms</span>
                        </h3>
                        <p class="text-slate-500 text-sm font-light leading-relaxed mb-8">
                            Términos internacionales que definen hasta qué punto el vendedor y el comprador asumen costos, trámites aduaneros y riesgos durante el traslado:
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            {incoterms.map((term) => (
                                <div class="p-5 rounded-2xl bg-stone-50 border border-stone-100">
                                    <div class="flex items-center gap-2.5 mb-2">
                                        <span class="bg-[#002845] text-[#BAD700] text-xs font-black px-2.5 py-1 rounded-lg">
                                            {term.code}
                                        </span>
                                        <span class="font-bold text-sm text-[#002845]">{term.name}</span>
                                    </div>
                                    <p class="text-xs text-slate-600 leading-relaxed">
                                        {term.desc}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>

    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>   