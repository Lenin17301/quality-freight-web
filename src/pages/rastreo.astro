---
// src/pages/rastreo.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
    lang="es"
    title="Rastreo en Tiempo Real | Quality Freight Service" 
    description="Rastree el estado y la ubicación de su carga internacional en tiempo real con nuestro sistema integrado."
>
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden pb-24 pt-32 min-h-screen">
        <section class="max-w-4xl mx-auto px-6 mb-12 text-center md:text-left flex flex-col md:flex-row items-center gap-8">
            <div class="w-20 h-20 text-[#002845] shrink-0">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3"></path></svg>
                <svg fill="currentColor" viewBox="0 0 24 24" class="w-full h-full"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"></path></svg>
            </div>
            <div>
                <h1 class="text-4xl md:text-5xl font-light text-[#002845] mb-2 leading-tight">
                    Rastrea tu carga <span class="font-black text-[#BAD700]">en tiempo real</span>
                </h1>
                <p class="text-gray-500 text-sm">Ingresa tu número de guía o contenedor para conocer el estado actual y la ubicación de tu envío.</p>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-6 mb-16">
            <div class="bg-[#E8ECEE] rounded-[2rem] p-6 flex flex-col md:flex-row gap-4 items-center">
                <div class="w-full">
                    <input type="text" placeholder="Ingresa tu número de guía o contenedor" class="w-full bg-white border-none rounded-xl px-6 py-4 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none shadow-sm" value="QTYU1234567" />
                    <p class="text-[10px] text-gray-400 mt-2 ml-2">Ejemplo: QTYU1234567 / BL123456789</p>
                </div>
                <button class="w-full md:w-auto bg-[#002845] text-white font-bold px-10 py-4 rounded-xl hover:bg-[#001c30] transition-colors shadow-lg whitespace-nowrap mb-6 md:mb-0">
                    Rastrear envío
                </button>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-6 mb-12">
            <div class="border border-gray-200 rounded-[2rem] p-8 md:p-10 shadow-sm relative overflow-hidden">
                <div class="flex flex-col lg:flex-row gap-10 mb-12">
                    <div class="w-full lg:w-1/4">
                        <span class="inline-block bg-[#BAD700] text-white font-bold text-sm px-6 py-1.5 rounded-full mb-6">En tránsito</span>
                        <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Número de guía</p>
                        <p class="text-xl font-black text-[#002845] mb-4">QTYU1234567</p>
                        <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Tipo de carga</p>
                        <p class="text-lg font-bold text-[#002845] mb-4">Carga Marítima</p>
                        <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Ruta</p>
                        <p class="text-sm font-bold text-[#002845]">Shanghai, CN &rarr; Los Angeles, USA</p>
                    </div>
                    <div class="w-full lg:w-2/4">
                        <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Barco en tránsito" class="w-full h-48 object-cover rounded-2xl shadow-md" />
                    </div>
                    <div class="w-full lg:w-1/4 flex flex-col justify-between gap-4">
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-[#002845] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <div><p class="text-[10px] text-gray-400 leading-tight">Fecha de salida</p><p class="text-sm font-bold text-[#002845]">20 Mayo 2026</p></div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-[#002845] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <div><p class="text-[10px] text-gray-400 leading-tight">Ubicación actual</p><p class="text-sm font-bold text-[#002845]">Océano Pacífico</p></div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-[#002845] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
                            <div><p class="text-[10px] text-gray-400 leading-tight">Próximo destino</p><p class="text-sm font-bold text-[#002845]">Los Angeles, USA</p></div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-[#002845] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div><p class="text-[10px] text-gray-400 leading-tight">Fecha estimada de llegada</p><p class="text-sm font-bold text-[#002845]">02 Junio 2026</p></div>
                        </div>
                    </div>
                </div>

                <div class="border-t border-gray-100 pt-8 relative">
                    <div class="absolute top-[52px] left-[10%] right-[10%] h-1 bg-gray-200 z-0"></div>
                    <div class="absolute top-[52px] left-[10%] w-[40%] h-1 bg-[#BAD700] z-0"></div>

                    <div class="flex justify-between relative z-10">
                        <div class="flex flex-col items-center w-1/5">
                            <div class="w-8 h-8 rounded-full bg-[#BAD700] flex items-center justify-center mb-2 border-4 border-white shadow-sm"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>
                            <p class="text-xs font-bold text-[#002845]">Recibido</p>
                            <p class="text-[10px] text-gray-400">18 Mayo 2026</p>
                        </div>
                        <div class="flex flex-col items-center w-1/5">
                            <div class="w-8 h-8 rounded-full bg-[#BAD700] flex items-center justify-center mb-2 border-4 border-white shadow-sm"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>
                            <p class="text-xs font-bold text-[#002845]">En tránsito</p>
                            <p class="text-[10px] text-gray-400">20 Mayo 2026</p>
                        </div>
                        <div class="flex flex-col items-center w-1/5">
                            <div class="w-8 h-8 rounded-full bg-[#002845] flex items-center justify-center mb-2 border-4 border-white shadow-md ring-4 ring-[#BAD700]/30 animate-pulse"><div class="w-3 h-3 bg-white rounded-full"></div></div>
                            <p class="text-xs font-bold text-[#002845]">En camino</p>
                            <p class="text-[10px] font-bold text-[#BAD700]">Actual</p>
                        </div>
                        <div class="flex flex-col items-center w-1/5">
                            <div class="w-8 h-8 rounded-full bg-gray-300 mb-2 border-4 border-white shadow-sm"></div>
                            <p class="text-xs font-bold text-gray-500">En destino</p>
                            <p class="text-[10px] text-gray-400">Próximamente</p>
                        </div>
                        <div class="flex flex-col items-center w-1/5">
                            <div class="w-8 h-8 rounded-full bg-gray-300 mb-2 border-4 border-white shadow-sm"></div>
                            <p class="text-xs font-bold text-gray-500">Entregado</p>
                            <p class="text-[10px] text-gray-400">Próximamente</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-6 mb-16 flex flex-col lg:flex-row gap-6">
            <div class="w-full lg:w-2/3 h-80 rounded-[2rem] overflow-hidden relative shadow-md bg-[#002845]">
                <img src="https://images.pexels.com/photos/414916/pexels-photo-414916.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Mapa de Ruta Satelital" class="w-full h-full object-cover opacity-60 mix-blend-overlay" />
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <svg class="w-full h-full" style="position: absolute; top: 0; left: 0;">
                        <path d="M 150 160 Q 400 250 650 140" fill="transparent" stroke="white" stroke-width="2" stroke-dasharray="5,5" class="opacity-70"></path>
                    </svg>
                    <div class="absolute left-[15%] top-[40%] flex flex-col items-center">
                        <div class="w-4 h-4 bg-[#BAD700] rounded-full border-2 border-white shadow-lg"></div>
                        <span class="bg-white text-[#002845] text-xs font-bold px-2 py-1 rounded-md mt-2 shadow-sm">Shanghai, CN</span>
                    </div>
                    <div class="absolute left-[50%] top-[60%]">
                        <div class="w-12 h-12 bg-[#BAD700] rounded-full flex items-center justify-center border-4 border-white shadow-xl animate-bounce">
                            <span class="text-xl">🚢</span>
                        </div>
                    </div>
                    <div class="absolute right-[15%] top-[35%] flex flex-col items-center">
                        <div class="w-4 h-4 bg-[#BAD700] rounded-full border-2 border-white shadow-lg"></div>
                        <span class="bg-white text-[#002845] text-xs font-bold px-2 py-1 rounded-md mt-2 shadow-sm">Los Angeles, USA</span>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-1/3 bg-[#E8ECEE] rounded-[2rem] p-8 flex flex-col justify-center">
                <p class="text-lg font-black text-[#002845] mb-1">Ruta del envío</p>
                <p class="text-sm text-gray-600 mb-6">Shanghai, CN &rarr; Los Angeles, USA</p>
                <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Transporte</p>
                <p class="text-base font-bold text-[#002845] mb-4">Marítimo</p>
                <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Contenedor</p>
                <p class="text-base font-bold text-[#002845] mb-4">40 HC</p>
                <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Número de BL</p>
                <p class="text-base font-bold text-[#002845]">BL123456789</p>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-[#E8ECEE] rounded-2xl p-6 flex items-center gap-4">
                <div class="w-12 h-12 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </div>
                <div><h4 class="font-black text-[#002845] text-sm">Notificaciones</h4><p class="text-[10px] text-gray-500 leading-tight">Recibe actualizaciones de tu envío en cada etapa.</p></div>
            </div>
            <div class="bg-[#E8ECEE] rounded-2xl p-6 flex items-center gap-4">
                <div class="w-12 h-12 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div><h4 class="font-black text-[#002845] text-sm">Rastreo en tiempo real</h4><p class="text-[10px] text-gray-500 leading-tight">Conoce la ubicación exacta de tu carga en todo momento.</p></div>
            </div>
            <div class="bg-[#E8ECEE] rounded-2xl p-6 flex items-center gap-4">
                <div class="w-12 h-12 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <div><h4 class="font-black text-[#002845] text-sm">Seguro y confiable</h4><p class="text-[10px] text-gray-500 leading-tight">Tu información y la de tu carga están 100% protegidas.</p></div>
            </div>
        </section>
    </main>
    
    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>