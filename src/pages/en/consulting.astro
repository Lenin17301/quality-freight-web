---
// src/pages/en/consulting.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import QEmblem from '../../components/QEmblem.astro';

// Replace this email with your Gmail for testing or Quality's final inbox
const destinationEmail = "lceballos17301@gmail.com";

const schemaData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "International Trade Consulting & Freight Quoting",
    "provider": {
        "@type": "Organization",
        "name": "Quality Freight Service, C.A.",
        "url": "https://qualityfs.com.ve/en/"
    },
    "description": "Specialized consulting in import, export, tariff classification, regulatory compliance, and logistics cost optimization.",
    "areaServed": "VE",
    "inLanguage": "en"
};
---

<BaseLayout 
    lang="en"
    title="International Trade Consulting | Quality Freight Service" 
    description="Specialized consulting in import, export, regulatory compliance, and logistics cost optimization." 
>
    <div slot="header">
        <Navbar lang="en" />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <main class="bg-white overflow-hidden pb-24">
        
        <!-- HERO CONSULTING -->
        <section class="pt-32 pb-16 px-6 lg:pt-40 max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-16">
                <!-- Text & Icons -->
                <div class="w-full lg:w-1/2">
                    <h1 class="text-4xl md:text-5xl font-light text-[#002845] mb-6 leading-tight">
                        Specialized consulting in <span class="font-black text-[#BAD700]">international trade</span>
                    </h1>
                    <p class="text-gray-500 mb-10 leading-relaxed text-sm md:text-base">
                        We accompany you in every step of your international operation, providing personalized advice so you can make safe and efficient decisions. We maximize the profitability of your supply chain.
                    </p>

                    <!-- Benefits (3 columns) -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <h3 class="font-black text-[#002845] text-sm leading-tight mb-1">Personalized<br/>Consulting</h3>
                            <p class="text-[11px] text-gray-500 leading-tight">Solutions adapted to your business.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
                            </div>
                            <h3 class="font-black text-[#002845] text-sm leading-tight mb-1">Regulatory<br/>Compliance</h3>
                            <p class="text-[11px] text-gray-500 leading-tight">We guide you through requirements and regulations.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                            </div>
                            <h3 class="font-black text-[#002845] text-sm leading-tight mb-1">Cost<br/>Optimization</h3>
                            <p class="text-[11px] text-gray-500 leading-tight">Strategies to improve your operations.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Image -->
                <div class="w-full lg:w-1/2 relative">
                    <div class="absolute -top-10 -right-10 w-64 h-64 bg-[#E8ECEE] rounded-full z-0 pointer-events-none"></div>
                    <img 
                        src="https://images.pexels.com/photos/7734158/pexels-photo-7734158.jpeg?auto=compress&cs=tinysrgb&w=800" 
                        alt="International trade and logistics consulting Quality Freight Service" 
                        width="800"
                        height="533"
                        fetchpriority="high"
                        loading="eager"
                        decoding="sync"
                        class="relative z-10 w-full h-[400px] object-cover rounded-[3rem] shadow-2xl" 
                    />
                </div>
            </div>
        </section>

        <!-- SERVICES (ZIG-ZAG) -->
        <section class="py-16 px-6 max-w-7xl mx-auto relative">
            <div class="absolute top-1/2 -left-32 w-64 h-64 bg-[#BAD700] rounded-full opacity-20 -translate-y-1/2 pointer-events-none"></div>
            
            <h2 class="text-3xl md:text-5xl font-light text-[#002845] text-center mb-16 relative z-10 leading-tight">
                <QEmblem 
                    class="inline-block w-10 h-10 md:w-12 md:h-12 object-contain align-baseline mr-2 -mb-1" 
                    decorative={true} 
                    widths={[64, 96]} 
                />Our Consulting <span class="font-black text-[#BAD700]">Services</span>
            </h2>

            <div class="space-y-6 relative z-10">
                <!-- Block 1 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Import and Export<br/>Consulting</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Strategic planning of your international movements. We evaluate the viability of your projects, identify market opportunities, and structure efficient routes to reduce transit times and operational costs.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Ocean import and export route planning" width="800" height="533" loading="lazy" decoding="async" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Block 2 -->
                <div class="flex flex-col md:flex-row-reverse gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Tariff Classification<br/>and Documentation</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Avoid fines and delays at customs. Our experts determine the precise tariff codes for your merchandise and manage certificates of origin, sanitary permits, and special required licenses.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/7734739/pexels-photo-7734739.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Tariff classification and customs documentation" width="800" height="533" loading="lazy" decoding="async" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Block 3 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">International Logistics<br/>Management</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Development of turnkey projects (Door-to-Door). We coordinate all actors in the chain: shipping lines, airlines, ground carriers, and customs brokers, ensuring total fluidity.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Turnkey door-to-door global logistics management" width="800" height="533" loading="lazy" decoding="async" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>
            </div>
        </section>

        <!-- QUOTE FORM (ANCHOR #quote) -->
        <section id="quote" class="py-16 px-6 scroll-mt-28">
            <div class="max-w-4xl mx-auto bg-white rounded-[3rem] p-8 md:p-12 shadow-[0_20px_50px_rgba(0,40,69,0.1)] border border-stone-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#BAD700] rounded-bl-[100%] opacity-20 pointer-events-none"></div>
                
                <div class="text-center mb-10 relative z-10">
                    <h2 class="text-3xl font-black text-[#002845] mb-2">Request a Quote</h2>
                    <p class="text-gray-500 text-sm">Complete the form and we will contact you with a customized proposal.</p>
                </div>

                <form 
                    id="quote-form-en" 
                    action={`https://formsubmit.co/${destinationEmail}`} 
                    method="POST"
                    data-ajax-url={`https://formsubmit.co/ajax/${destinationEmail}`}
                    class="space-y-6 relative z-10"
                >
                    <input type="hidden" name="_subject" value="New quote request - Quality Freight Service (EN)" />
                    <input type="hidden" name="_template" value="table" />
                    <input type="hidden" name="_captcha" value="false" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="quote_name_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Full Name</label>
                            <input type="text" id="quote_name_en" name="Full_Name" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label for="quote_company_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Company</label>
                            <input type="text" id="quote_company_en" name="Company" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="quote_email_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Corporate Email</label>
                            <input type="email" id="quote_email_en" name="email" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label for="quote_phone_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Phone Number</label>
                            <input type="tel" id="quote_phone_en" name="Phone_Number" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="quote_transport_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Transport Type</label>
                            <select id="quote_transport_en" name="Transport_Type" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none" required>
                                <option value="" disabled selected>Select...</option>
                                <option value="Ocean Freight">Ocean Freight</option>
                                <option value="Air Freight">Air Freight</option>
                                <option value="Ground Freight">Ground Freight</option>
                                <option value="Customs Brokerage">Customs Brokerage</option>
                            </select>
                        </div>
                        <div>
                            <label for="quote_cargo_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Cargo Type</label>
                            <select id="quote_cargo_en" name="Cargo_Type" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none" required>
                                <option value="" disabled selected>Select...</option>
                                <option value="Full Container Load (FCL)">Full Container Load (FCL)</option>
                                <option value="Less than Container Load (LCL)">Less than Container Load (LCL)</option>
                                <option value="Breakbulk Cargo">Breakbulk Cargo</option>
                                <option value="Hazardous Materials (IMO)">Hazardous Materials (IMO)</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label for="quote_details_en" class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Shipment Details</label>
                        <textarea id="quote_details_en" name="Shipment_Details" rows="4" placeholder="Describe volume, dimensions, ports of origin and destination..." class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none resize-none transition-shadow" required></textarea>
                    </div>
                    <div class="flex items-start gap-3">
                        <input type="checkbox" id="terms_en" class="mt-1 accent-[#BAD700] w-4 h-4 cursor-pointer" required />
                        <label for="terms_en" class="text-xs text-gray-500 cursor-pointer">I agree that my data will be stored for commercial contact and quoting purposes.</label>
                    </div>
                    
                    <button type="submit" id="quote-submit-btn-en" class="w-full bg-[#002845] text-white font-bold text-lg py-4 rounded-xl hover:bg-[#001c30] transition-colors shadow-lg mt-4 cursor-pointer">
                        Send Request
                    </button>

                    <!-- Inline visual confirmation -->
                    <div id="quote-success-msg-en" class="hidden p-5 rounded-2xl bg-[#BAD700]/20 border border-[#BAD700] text-[#002845]" role="status">
                        <p class="font-black text-base">Request sent successfully!</p>
                        <p class="text-sm mt-1 text-slate-700">We have received your cargo details. A Quality Freight Service specialist will send your quote shortly.</p>
                    </div>
                </form>
            </div>
        </section>

    </main>
    
    <div slot="footer">
        <Footer lang="en" />
    </div>
</BaseLayout>

<script>
    // 1. Guaranteed scroll when arriving with #quote from another page
    function jumpToQuote() {
        if (window.location.hash === '#quote') {
            const target = document.getElementById('quote');
            if (target) {
                setTimeout(() => {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 120);
            }
        }
    }
    document.addEventListener('DOMContentLoaded', jumpToQuote);
    document.addEventListener('astro:page-load', jumpToQuote);

    // 2. AJAX submission via FormSubmit + GA4 conversion event
    const formEn = document.getElementById('quote-form-en') as HTMLFormElement | null;
    const submitBtnEn = document.getElementById('quote-submit-btn-en') as HTMLButtonElement | null;
    const successMsgEn = document.getElementById('quote-success-msg-en');

    if (formEn && submitBtnEn) {
        formEn.addEventListener('submit', async (e) => {
            e.preventDefault();
            const ajaxUrl = formEn.dataset.ajaxUrl;
            if (!ajaxUrl) return;

            submitBtnEn.disabled = true;
            submitBtnEn.textContent = 'Sending request...';

            try {
                const formData = new FormData(formEn);
                const response = await fetch(ajaxUrl, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    body: formData
                });

            if (response.ok) {
                if (typeof (window as any).gtag === 'function') {
                    (window as any).gtag('event', 'generate_lead', {
                        'event_category': 'formulario_asesoria',
                        'event_label': 'solicitud_cotizacion_en',
                        'value': 1
                    });
                }
                formEn.reset();
                if (successMsgEn) {
                    successMsgEn.classList.remove('hidden');
                    successMsgEn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                } else {
                    alert('There was an issue sending your request. Please try again.');
                }
            } catch {
                alert('Connection error. Please check your internet connection and try again.');
            } finally {
                submitBtnEn.disabled = false;
                submitBtnEn.textContent = 'Send Request';
            }
        });
    }
</script>