---
// src/pages/en/consulting.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
    lang="en"
    title="International Trade Consulting | Quality Freight Service" 
    description="Specialized consulting in import, export, regulatory compliance, and logistics cost optimization." 
>
    
    <div slot="header">
        <Navbar lang="en" />
    </div>

    <main class="bg-white overflow-hidden pb-24">
        
        <!-- HERO CONSULTING -->
        <section class="pt-32 pb-16 px-6 lg:pt-40 max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-16">
                <!-- Text & Icons -->
                <div class="w-full lg:w-1/2">
                    <h1 class="text-4xl md:text-5xl font-light text-[#002845] mb-6 leading-tight">
                        Specialized consulting in <span class="font-black text-[#BAD700]">international trade</span>
                    </h1>
                    <p class="text-gray-500 mb-10 leading-relaxed text-sm md:text-base">
                        We accompany you in every step of your international operation, providing personalized advice so you can make safe and efficient decisions. We maximize the profitability of your supply chain.
                    </p>

                    <!-- Benefits (3 columns) -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Personalized<br/>Consulting</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">Solutions adapted to your business.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Regulatory<br/>Compliance</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">We guide you through requirements and regulations.</p>
                        </div>
                        <div>
                            <div class="w-10 h-10 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                            </div>
                            <h4 class="font-black text-[#002845] text-sm leading-tight mb-1">Cost<br/>Optimization</h4>
                            <p class="text-[10px] text-gray-500 leading-tight">Strategies to improve your operations.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Image -->
                <div class="w-full lg:w-1/2 relative">
                    <div class="absolute -top-10 -right-10 w-64 h-64 bg-[#E8ECEE] rounded-full z-0"></div>
                    <img src="https://images.pexels.com/photos/7734158/pexels-photo-7734158.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Logistics Consulting" class="relative z-10 w-full h-[400px] object-cover rounded-[3rem] shadow-2xl" />
                </div>
            </div>
        </section>

        <!-- SERVICES (ZIG-ZAG) -->
        <section class="py-16 px-6 max-w-7xl mx-auto relative">
            <div class="absolute top-1/2 -left-32 w-64 h-64 bg-[#BAD700] rounded-full opacity-20 -translate-y-1/2"></div>
            
            <h2 class="text-3xl md:text-5xl font-light text-[#002845] text-center mb-16 relative z-10">
                Our Consulting <span class="font-black text-[#BAD700]">Services</span>
            </h2>

            <div class="space-y-6 relative z-10">
                <!-- Block 1 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Import and Export<br/>Consulting</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Strategic planning of your international movements. We evaluate the viability of your projects, identify market opportunities, and structure efficient routes to reduce transit times and operational costs.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Import" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Block 2 -->
                <div class="flex flex-col md:flex-row-reverse gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">Tariff Classification<br/>and Documentation</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Avoid fines and delays at customs. Our experts determine the precise tariff codes for your merchandise and manage certificates of origin, sanitary permits, and special required licenses.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/7734739/pexels-photo-7734739.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Documentation" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>

                <!-- Block 3 -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/2 bg-[#E8ECEE] rounded-[2rem] p-10 flex flex-col justify-center">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 bg-[#BAD700] rounded-full flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-2xl font-black text-[#002845] leading-tight">International Logistics<br/>Management</h3>
                        </div>
                        <p class="text-sm text-gray-500 ml-12">Development of turnkey projects (Door-to-Door). We coordinate all actors in the chain: shipping lines, airlines, ground carriers, and customs brokers, ensuring total fluidity.</p>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Global Logistics" class="w-full h-64 object-cover rounded-[2rem] shadow-md" />
                    </div>
                </div>
            </div>
        </section>

        <!-- QUOTE FORM -->
        <section class="py-16 px-6">
            <div class="max-w-4xl mx-auto bg-white rounded-[3rem] p-8 md:p-12 shadow-[0_20px_50px_rgba(0,40,69,0.1)] border border-stone-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#BAD700] rounded-bl-[100%] opacity-20"></div>
                
                <div class="text-center mb-10 relative z-10">
                    <h2 class="text-3xl font-black text-[#002845] mb-2">Request a Quote</h2>
                    <p class="text-gray-500 text-sm">Complete the form and we will contact you with a customized proposal.</p>
                </div>

                <form class="space-y-6 relative z-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Full Name</label>
                            <input type="text" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Company</label>
                            <input type="text" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Corporate Email</label>
                            <input type="email" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Phone Number</label>
                            <input type="tel" class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none transition-shadow" required />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Transport Type</label>
                            <select class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none appearance-none" required>
                                <option value="" disabled selected>Select...</option>
                                <option value="ocean">Ocean Freight</option>
                                <option value="air">Air Freight</option>
                                <option value="ground">Ground Freight</option>
                                <option value="customs">Customs Brokerage</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Cargo Type</label>
                            <select class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none appearance-none" required>
                                <option value="" disabled selected>Select...</option>
                                <option value="fcl">Full Container Load (FCL)</option>
                                <option value="lcl">Less than Container Load (LCL)</option>
                                <option value="breakbulk">Breakbulk Cargo</option>
                                <option value="hazardous">Hazardous Materials (IMO)</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">Shipment Details</label>
                        <textarea rows="4" placeholder="Describe volume, dimensions, ports of origin and destination..." class="w-full bg-[#E8ECEE] border-none rounded-xl px-4 py-3 text-slate-700 focus:ring-2 focus:ring-[#BAD700] outline-none resize-none transition-shadow" required></textarea>
                    </div>
                    <div class="flex items-start gap-3">
                        <input type="checkbox" id="terms_en" class="mt-1 accent-[#BAD700] w-4 h-4 cursor-pointer" required />
                        <label for="terms_en" class="text-xs text-gray-500 cursor-pointer">I agree that my data will be stored for commercial contact and quoting purposes.</label>
                    </div>
                    
                    <button type="submit" class="w-full bg-[#002845] text-white font-bold text-lg py-4 rounded-xl hover:bg-[#001c30] transition-colors shadow-lg mt-4">
                        Send Request
                    </button>
                </form>
            </div>
        </section>

    </main>
    
    <div slot="footer">
        <Footer lang="en" />
    </div>
</BaseLayout>