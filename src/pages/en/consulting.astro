---
// src/components/ContactForm.astro
import QuoteWizard from './QuoteWizard.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const destinationEmail = "lceballos17301@gmail.com";
const anchorId = lang === 'es' ? 'cotizador' : 'quote';

const t = {
  es: {
    badge: "Consulta Gratis",
    title: "Solicitar una ",
    titleBold: "cotización",
    description: "Para solicitar cotizaciones por favor complete el asistente a continuación o comuníquese con nosotros a través de los números de teléfonos +58 212.762.26.92 y +58 212.762.26.95"
  },
  en: {
    badge: "Free Consultation",
    title: "Request a ",
    titleBold: "quote",
    description: "To request a quote, please complete the wizard below or contact us at +58 212.762.26.92 and +58 212.762.26.95"
  }
};

const text = t[lang];
---

<section id={anchorId} class="py-24 px-6 bg-stone-50 border-t border-stone-200 scroll-mt-28">
    <div class="max-w-4xl mx-auto bg-white p-8 md:p-14 rounded-[2.5rem] shadow-sm border border-stone-100">
        <div class="mb-10">
            <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs mb-3 block">{text.badge}</span>
            <h2 class="text-3xl md:text-5xl font-light text-[#002845] mb-4">
                {text.title}<span class="font-black">{text.titleBold}</span>
            </h2>
            <p class="text-slate-500 font-light leading-relaxed text-sm md:text-base">
                {text.description}
            </p>
        </div>

        <QuoteWizard lang={lang} destinationEmail={destinationEmail} />
    </div>
</section>