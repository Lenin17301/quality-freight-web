---
// src/pages/en/about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
    lang="en" 
    title="About Us | Quality Freight Service" 
    description="Learn about our mission, vision, and values. We are experts in international transport and customs logistics with over 15 years of experience."
>
    <div slot="header">
        <Navbar lang="en" />
    </div>

    <main class="bg-white overflow-hidden pb-24">
        <!-- HEADER / HERO -->
        <section class="pt-32 pb-20 px-6 lg:pt-40 max-w-7xl mx-auto flex flex-col-reverse lg:flex-row items-center gap-16">
            <div class="w-full lg:w-1/2 relative">
                <div class="absolute top-1/2 left-0 w-72 h-72 bg-[#002845] rounded-full opacity-10 -translate-y-1/2 -translate-x-1/4"></div>
                <div class="grid grid-cols-2 gap-4 relative z-10">
                    <img src="https://images.pexels.com/photos/6169046/pexels-photo-6169046.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Air Cargo" class="rounded-[2rem] w-full h-56 object-cover col-span-2 shadow-lg" />
                    <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Ocean Freight" class="rounded-[2rem] w-full h-48 object-cover shadow-lg" />
                    <img src="https://images.pexels.com/photos/2226458/pexels-photo-2226458.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Ground Freight" class="rounded-[2rem] w-full h-48 object-cover shadow-lg" />
                </div>
            </div>

            <div class="w-full lg:w-1/2">
                <h1 class="text-5xl md:text-6xl font-light text-[#002845] mb-6">
                    About <span class="font-black text-[#BAD700]">us</span>
                </h1>
                <p class="text-gray-500 mb-10 leading-relaxed">
                    We are a company specialized in international freight transport, committed to offering safe, efficient logistics solutions tailored to each client's needs. Our goal is to be the strongest link in your supply chain.
                </p>
                <!-- Iconos de valor (igual que español) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <h4 class="font-black text-[#002845] leading-tight mb-1">Global<br/>Coverage</h4>
                        <p class="text-[10px] text-gray-500 leading-tight">We connect your cargo with the world.</p>
                    </div>
                    <div>
                        <h4 class="font-black text-[#002845] leading-tight mb-1">Guaranteed<br/>Security</h4>
                        <p class="text-[10px] text-gray-500 leading-tight">We protect your cargo at every stage.</p>
                    </div>
                    <div>
                        <h4 class="font-black text-[#002845] leading-tight mb-1">Commitment<br/>to clients</h4>
                        <p class="text-[10px] text-gray-500 leading-tight">Your success is our priority.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- MISSION -->
        <section class="px-6 mb-24">
            <div class="max-w-6xl mx-auto bg-[#002845] rounded-[3rem] overflow-hidden flex flex-col md:flex-row items-center shadow-2xl">
                <div class="w-full md:w-1/2 h-64 md:h-96">
                    <img src="https://images.pexels.com/photos/1117210/pexels-photo-1117210.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Our Mission" class="w-full h-full object-cover" />
                </div>
                <div class="w-full md:w-1/2 p-10 md:p-16">
                    <h2 class="text-4xl md:text-5xl font-light text-white mb-6">
                        Our <span class="font-black text-[#BAD700]">Mission</span>
                    </h2>
                    <p class="text-stone-300 text-lg leading-relaxed">
                        To provide international logistics solutions with high standards of quality, security, and efficiency, generating value and trust in every shipment. We focus on exceeding our commercial partners' expectations.
                    </p>
                </div>
            </div>
        </section>

        <section class="px-6 mb-24">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-4xl md:text-5xl font-light text-[#002845] text-center mb-12">
                    Our <span class="font-black text-[#BAD700]">Values</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center hover:-translate-y-2 transition-transform">
                        <h4 class="font-black text-[#002845] text-xl mb-3">Integrity</h4>
                        <p class="text-xs text-gray-500">We act with honesty and transparency.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center hover:-translate-y-2 transition-transform">
                        <h4 class="font-black text-[#002845] text-xl mb-3">Excellence</h4>
                        <p class="text-xs text-gray-500">We seek continuous improvement.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center hover:-translate-y-2 transition-transform">
                        <h4 class="font-black text-[#002845] text-xl mb-3">Responsibility</h4>
                        <p class="text-xs text-gray-500">We deliver on our promises.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center hover:-translate-y-2 transition-transform">
                        <h4 class="font-black text-[#002845] text-xl mb-3">Teamwork</h4>
                        <p class="text-xs text-gray-500">We collaborate closely.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div slot="footer">
        <Footer lang="en" />
    </div>
</BaseLayout>