---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
    lang="es" 
    title="Logística y Carga Internacional | Quality Freight Service" 
    description="Soluciones integrales de transporte marítimo, aéreo y terrestre. Gestionamos sus trámites aduanales con seguridad, agilidad y tarifas competitivas."
>
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden">
        
        <!-- SECCIÓN 1: HERO SECTION -->
        <section class="relative bg-[#E8ECEE] pt-32 pb-64 px-6 lg:pt-40 lg:pb-72 overflow-hidden" style="border-bottom-left-radius: 4rem; border-bottom-right-radius: 4rem;">
            <div class="absolute top-0 right-0 w-96 h-96 bg-[#BAD700] rounded-bl-full opacity-80 -translate-y-1/2 translate-x-1/4"></div>
            <div class="absolute bottom-0 left-0 w-80 h-80 bg-[#002845] rounded-tr-full opacity-90 translate-y-1/4 -translate-x-1/4"></div>

            <div class="relative z-10 max-w-7xl mx-auto flex flex-col-reverse lg:flex-row items-center gap-12">
                
                <!-- Imagen Dinámica y Globos Flotantes -->
                <div class="w-full lg:w-1/2 relative mt-16 lg:mt-0">
                    <!-- Imagen principal con ID para manipularla con JS -->
                    <img 
                        id="hero-img"
                        src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" 
                        alt="Logística y Envíos" 
                        width="800" 
                        height="533" 
                        class="w-full drop-shadow-2xl rounded-3xl object-cover h-[400px] transition-opacity duration-500" 
                    />
                    
                    <!-- Globos flotantes dinámicos -->
                    <div class="absolute -bottom-32 lg:-bottom-24 left-0 right-0 flex flex-col md:flex-row justify-center gap-4 px-4">
                        
                        <!-- Globo 1 -->
                        <a href="/servicios" data-image="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" class="hover-trigger bg-white rounded-3xl p-5 shadow-xl w-full md:w-1/3 hover:-translate-y-2 transition-all block group border-2 border-transparent hover:border-[#BAD700]">
                            <span class="block font-black text-[#002845] text-lg leading-tight mb-2">Logística y envíos</span>
                            <span class="text-xs text-gray-500 group-hover:text-[#002845] transition-colors leading-relaxed block">Transporte de carga internacional y nacional</span>
                        </a>
                        
                        <!-- Globo 2 -->
                        <a href="https://wa.me/584120000000" target="_blank" data-image="https://images.pexels.com/photos/5805404/pexels-photo-5805404.jpeg?auto=compress&cs=tinysrgb&w=800" class="hover-trigger bg-[#BAD700] rounded-3xl p-5 shadow-xl w-full md:w-1/3 hover:-translate-y-2 transition-all scale-100 md:scale-110 z-10 block group">
                            <span class="block font-black text-[#002845] text-lg leading-tight mb-2">Agente de aduana</span>
                            <span class="text-xs text-[#002845]/80 font-medium leading-relaxed block">Asistencia para despachos eficientes</span>
                        </a>
                        
                        <!-- Globo 3 -->
                        <a href="/contacto" data-image="https://images.pexels.com/photos/3184611/pexels-photo-3184611.jpeg?auto=compress&cs=tinysrgb&w=800" class="hover-trigger bg-white rounded-3xl p-5 shadow-xl w-full md:w-1/3 hover:-translate-y-2 transition-all block group border-2 border-transparent hover:border-[#BAD700]">
                            <span class="block font-black text-[#002845] text-lg leading-tight mb-2">Asesoría experta</span>
                            <span class="text-xs text-gray-500 group-hover:text-[#002845] transition-colors leading-relaxed block">Acompañamiento personalizado para empresas en expansión</span>
                        </a>

                    </div>
                </div>

                <!-- Textos Principales -->
                <div class="w-full lg:w-1/2 flex flex-col items-end text-right">
                    <h1 class="text-5xl md:text-6xl font-light text-[#002845] mb-8 leading-tight">
                        Soluciones logísticas y <span class="font-black text-[#BAD700]">servicio de envío<br/>de carga internacional</span>
                    </h1>
                    <a href="/asesoria" class="bg-[#002845] text-white font-bold text-xl py-3 px-12 rounded-full shadow-lg hover:bg-[#001c30] transition-colors mb-4 relative">
                        cotiza ahora
                        <span class="absolute -bottom-4 -right-4 text-3xl">🚢</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: IMPULSAMOS EL CRECIMIENTO -->
        <section class="py-24 px-6 bg-white">
            <div class="max-w-7xl mx-auto text-center max-w-4xl">
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-light text-[#002845] mb-6 leading-tight">
                    <span class="text-[#BAD700] font-bold text-6xl mr-2">Q</span>Impulsamos el crecimiento de tu negocio <span class="font-black">con una fluidez única.</span>
                </h2>
                <p class="text-gray-500 text-lg md:text-xl leading-relaxed mb-12">
                    Diseñamos rutas logísticas optimizadas para que su mercancía llegue a su destino final con total seguridad. Contamos con una red global de socios estratégicos que garantizan tiempos de tránsito ágiles.
                </p>
                
                <div class="flex justify-center gap-8 md:gap-16 flex-wrap">
                    <div>
                        <p class="text-5xl font-black text-[#002845]">5000+</p>
                        <p class="text-sm font-bold text-[#BAD700] uppercase tracking-widest mt-2">Envíos exitosos</p>
                    </div>
                    <div>
                        <p class="text-5xl font-black text-[#002845]">100%</p>
                        <p class="text-sm font-bold text-[#BAD700] uppercase tracking-widest mt-2">Seguridad</p>
                    </div>
                    <div>
                        <p class="text-5xl font-black text-[#002845]">15+</p>
                        <p class="text-sm font-bold text-[#BAD700] uppercase tracking-widest mt-2">Años de exp.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 3: RASTREO Y SERVICIO TERRESTRE DESTACADO -->
        <section class="py-20 px-6 bg-[#002845] relative overflow-hidden" style="border-radius: 4rem;">
            <!-- Background Decoration -->
            <div class="absolute inset-0 z-0 opacity-10">
                <div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(#BAD700 2px, transparent 2px); background-size: 40px 40px;"></div>
            </div>

            <div class="max-w-7xl mx-auto relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    
                    <!-- Tarjeta Rastreo (Estrategia Híbrida) -->
                    <a href="https://tracking.magaya.com/?orgname=38465" target="_blank" rel="noopener noreferrer" class="bg-white rounded-[3rem] p-10 md:p-12 shadow-2xl hover:-translate-y-2 transition-transform group flex flex-col justify-between relative overflow-hidden">
                        <div class="absolute -right-10 -top-10 w-48 h-48 bg-[#E8ECEE] rounded-full opacity-50 group-hover:scale-150 transition-transform duration-700"></div>
                        <div class="relative z-10">
                            <span class="text-6xl mb-6 block group-hover:scale-110 transition-transform origin-left">📦</span>
                            <h3 class="text-3xl md:text-4xl font-black text-[#002845] mb-4">Sistema de Rastreo</h3>
                            <p class="text-gray-500 mb-8 text-lg">Monitorea el estatus de tu carga internacional en tiempo real a través de nuestro portal seguro Magaya LiveTrack.</p>
                        </div>
                        <span class="bg-[#BAD700] text-[#002845] font-bold py-4 px-8 rounded-full text-center group-hover:bg-[#a0be00] group-hover:text-white transition-colors text-lg relative z-10 w-full md:w-auto self-start">
                            Rastrear mi envío
                        </span>
                    </a>

                    <!-- Tarjeta Servicio Terrestre -->
                    <a href="/servicios/carga-terrestre" class="bg-[#BAD700] rounded-[3rem] p-10 md:p-12 shadow-2xl hover:-translate-y-2 transition-transform group flex flex-col justify-between relative overflow-hidden">
                        <div class="absolute -right-10 -top-10 w-48 h-48 bg-white rounded-full opacity-20 group-hover:scale-150 transition-transform duration-700"></div>
                        <div class="relative z-10">
                            <span class="text-6xl mb-6 block group-hover:scale-110 transition-transform origin-left">🚛</span>
                            <h3 class="text-3xl md:text-4xl font-black text-[#002845] mb-4">Servicio Terrestre</h3>
                            <p class="text-[#002845]/80 mb-8 text-lg font-medium">Además de importar tu mercancía, la llevamos directamente a las puertas de tu empresa. Distribución nacional segura y rápida.</p>
                        </div>
                        <span class="bg-[#002845] text-white font-bold py-4 px-8 rounded-full text-center group-hover:bg-[#001c30] transition-colors text-lg relative z-10 w-full md:w-auto self-start flex items-center justify-center gap-2">
                            Conoce más <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                        </span>
                    </a>

                </div>
            </div>
        </section>

        <!-- SECCIÓN 4: TESTIMONIOS -->
        <section class="py-24 px-6 bg-white">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-4xl md:text-5xl font-light text-[#002845] text-center mb-16">
                    <span class="text-[#BAD700] font-bold text-5xl mr-2">Q</span>Experiencias de <span class="font-black">Clientes</span>
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Tarjeta 1 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/3760370/pexels-photo-3760370.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Ejecutivo" width="150" height="150" class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Roberto Mendoza</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Importadora Sur C.A.</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"La gestión aduanera de Quality FS nos ahorró semanas de espera en el puerto. Su equipo se encargó de toda la documentación con una eficiencia que no habíamos visto antes con otros operadores."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>

                    <!-- Tarjeta 2 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/5805404/pexels-photo-5805404.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Supervisora Logística" width="150" height="150" class="w-full h-full object-cover object-top" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Elena Castillo</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Distribuciones Globales</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"Consolidar nuestra carga desde Asia siempre fue un dolor de cabeza hasta que empezamos a trabajar con ellos. El tracking es preciso y la atención es sumamente profesional en todo momento."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>

                    <!-- Tarjeta 3 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/3184611/pexels-photo-3184611.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Junta Directiva" width="150" height="150" class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Andrés Villalobos</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Retail & Moda Express</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"Utilizamos su servicio de carga aérea semanalmente. Las tarifas son inmejorables y la tranquilidad de saber que la mercancía llegará a los anaqueles a tiempo no tiene precio."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>
                </div>
            </div>
        </section>

    </main>
    
    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>

<!-- Script para el cambio dinámico de imágenes en el Hero -->
<!-- Script para el cambio dinámico de imágenes en el Hero -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const heroImg = document.getElementById('hero-img');
        const triggers = document.querySelectorAll('.hover-trigger');

        triggers.forEach(trigger => {
            // Cambiamos a función flecha y usamos 'trigger' en lugar de 'this'
            trigger.addEventListener('mouseenter', () => {
                const newSrc = trigger.getAttribute('data-image');
                
                if (newSrc && heroImg) {
                    // Animación suave de transición
                    heroImg.style.opacity = '0.7';
                    setTimeout(() => {
                        heroImg.setAttribute('src', newSrc);
                        heroImg.style.opacity = '1';
                    }, 150);
                }
            });
        });
    });
</script>