---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
    lang="es" 
    title="Logística y Carga Internacional | Quality Freight Service" 
    description="Soluciones integrales de transporte marítimo, aéreo y terrestre. Gestionamos sus trámites aduanales con seguridad, agilidad y tarifas competitivas."
>
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <main class="bg-white overflow-hidden">
        
        <!-- HERO SECTION -->
        <section class="relative bg-[#E8ECEE] pt-32 pb-40 px-6 lg:pt-40 lg:pb-56 overflow-hidden rounded-b-[4rem]">
            <div class="absolute top-0 right-0 w-96 h-96 bg-[#BAD700] rounded-bl-[100%] opacity-80 -translate-y-1/2 translate-x-1/4"></div>
            <div class="absolute bottom-0 left-0 w-80 h-80 bg-[#002845] rounded-tr-[100%] opacity-90 translate-y-1/4 -translate-x-1/4"></div>

            <div class="relative z-10 max-w-7xl mx-auto flex flex-col-reverse lg:flex-row items-center gap-12">
                <div class="w-full lg:w-1/2 relative">
                    <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Contenedor Marítimo" class="w-full drop-shadow-2xl rounded-2xl" />
                    
                    <!-- Pestañas flotantes apuntando a las subpáginas reales -->
                    <div class="absolute -bottom-10 left-0 right-0 flex justify-center gap-4 px-4">
                        <a href="/servicios/carga-aerea" class="bg-white rounded-2xl p-4 shadow-lg w-32 hover:-translate-y-2 transition-transform block">
                            <span class="block font-bold text-[#BAD700] text-lg leading-tight">Carga<br/>Aérea</span>
                            <span class="text-[10px] text-gray-500">Internacional</span>
                        </a>
                        <a href="/servicios/carga-maritima" class="bg-[#BAD700] rounded-2xl p-4 shadow-lg w-32 hover:-translate-y-2 transition-transform scale-110 z-10 block">
                            <span class="block font-bold text-white text-lg leading-tight">Carga<br/>Marítima</span>
                            <span class="text-[10px] text-[#002845]">Internacional</span>
                        </a>
                        <a href="/servicios/carga-terrestre" class="bg-white rounded-2xl p-4 shadow-lg w-32 hover:-translate-y-2 transition-transform block">
                            <span class="block font-bold text-[#BAD700] text-lg leading-tight">Carga<br/>Terrestre</span>
                            <span class="text-[10px] text-gray-500">Nacional</span>
                        </a>
                    </div>
                </div>

                <div class="w-full lg:w-1/2 flex flex-col items-end text-right">
                    <h1 class="text-5xl md:text-6xl font-light text-[#002845] mb-8 leading-tight">
                        Servicio Marítimo a <span class="font-black text-[#BAD700]">nivel<br/>internacional</span>
                    </h1>
                    <a href="/asesoria" class="bg-[#002845] text-white font-bold text-xl py-3 px-12 rounded-full shadow-lg hover:bg-[#001c30] transition-colors mb-12 relative">
                        cotiza ahora
                        <span class="absolute -bottom-4 -right-4 text-3xl">🚢</span>
                    </a>

                    <!-- Tracking Widget Mini -->
                    <div class="bg-white rounded-3xl shadow-xl p-4 w-72 text-center">
                        <p class="font-bold text-[#002845] mb-2 text-sm">Rastreo en tiempo real</p>
                        <div class="rounded-xl overflow-hidden h-32 relative group cursor-pointer" onclick="window.location.href='/rastreo'">
                            <img src="https://images.pexels.com/photos/1117210/pexels-photo-1117210.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Rastreo Logística" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            <div class="absolute inset-0 bg-black/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <span class="bg-[#BAD700] text-[#002845] font-bold py-1 px-4 rounded-full text-xs">Rastrear</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SERVICIOS DE TRANSPORTE -->
        <section class="py-24 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col md:flex-row items-center gap-12 mb-16">
                    <div class="w-full md:w-1/2">
                        <h2 class="text-4xl md:text-5xl font-light text-[#002845] mb-4">
                            <span class="text-[#BAD700] font-bold text-5xl mr-2">Q</span>Servicio de <span class="font-black">transporte internacional</span>
                        </h2>
                        <p class="text-gray-500 mb-8 text-sm md:text-base leading-relaxed">
                            Diseñamos rutas logísticas optimizadas para que su mercancía llegue a su destino final con total seguridad. Contamos con una red global de socios estratégicos que garantizan tiempos de tránsito ágiles y tarifas altamente competitivas en el mercado.
                        </p>
                        
                        <!-- Pestañas apuntando a subpáginas -->
                        <div class="flex flex-wrap gap-4 mb-12">
                            <a href="/servicios/carga-maritima" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Marítimo</a>
                            <a href="/servicios/carga-aerea" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Aéreo</a>
                            <a href="/servicios/carga-terrestre" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Terrestre</a>
                        </div>
                        
                        <div class="flex justify-between max-w-md">
                            <div>
                                <p class="text-4xl font-black text-[#002845]">5000+</p>
                                <p class="text-[10px] text-gray-400">Envíos exitosos</p>
                            </div>
                            <div>
                                <p class="text-4xl font-black text-[#002845]">100%</p>
                                <p class="text-[10px] text-gray-400">Seguridad de carga</p>
                            </div>
                            <div>
                                <p class="text-4xl font-black text-[#002845]">1200+</p>
                                <p class="text-[10px] text-gray-400">Clientes activos</p>
                            </div>
                        </div>
                    </div>
                    <div class="w-full md:w-1/2">
                        <img src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Barco" class="rounded-[3rem] w-full object-cover h-96 shadow-xl" />
                    </div>
                </div>

                <div class="space-y-8">
                    <!-- Aéreo -->
                    <div class="flex flex-col md:flex-row gap-6">
                        <div class="w-full md:w-2/3">
                            <img src="https://images.pexels.com/photos/6169046/pexels-photo-6169046.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Avión" class="rounded-4xl w-full h-72 object-cover shadow-md" />
                        </div>
                        <div class="w-full md:w-1/3 bg-[#E8ECEE] rounded-4xl p-8 flex flex-col justify-center items-end text-right">
                            <a href="/asesoria" class="bg-[#BAD700] text-white font-bold py-2 px-8 rounded-full mb-6 hover:bg-[#a0be00] transition-colors">cotiza ahora</a>
                            <h3 class="text-3xl font-black text-[#002845] mb-2">Servicio Aéreo</h3>
                            <p class="text-sm text-gray-500">Manejo expedito de carga crítica. Alianzas con las principales aerolíneas para asegurar espacio y prioridad en sus embarques urgentes a nivel mundial.</p>
                        </div>
                    </div>
                    <!-- Terrestre -->
                    <div class="flex flex-col md:flex-row-reverse gap-6">
                        <div class="w-full md:w-2/3">
                            <img src="https://images.pexels.com/photos/2226458/pexels-photo-2226458.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Camión" class="rounded-4xl w-full h-72 object-cover shadow-md" />
                        </div>
                        <div class="w-full md:w-1/3 bg-[#E8ECEE] rounded-4xl p-8 flex flex-col justify-center items-start text-left">
                            <a href="/asesoria" class="bg-[#BAD700] text-white font-bold py-2 px-8 rounded-full mb-6 hover:bg-[#a0be00] transition-colors">cotiza ahora</a>
                            <h3 class="text-3xl font-black text-[#002845] mb-2">Servicio Terrestre</h3>
                            <p class="text-sm text-gray-500">Distribución nacional y transfronteriza eficiente. Flotas monitoreadas 24/7 para garantizar recolecciones y entregas puerta a puerta en tiempo récord.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- POR QUÉ ELEGIR QUALITY -->
        <section class="py-16 px-6 bg-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-160 h-160 border-100 border-[#BAD700] rounded-full opacity-20 translate-x-1/2 -translate-y-1/4"></div>
            <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12 relative z-10">
                <div class="w-full md:w-1/2">
                    <h2 class="text-4xl md:text-5xl font-light text-[#002845] mb-6">
                        <span class="text-[#BAD700] font-bold text-5xl mr-2">Q</span>¿Porque elegir <span class="font-black">Quality Freight Service?</span>
                    </h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-8">
                        No somos solo un proveedor, somos su departamento de logística externo. Nos anticipamos a los retos aduaneros, reducimos sus costos operativos y le brindamos atención personalizada 24/7. Nuestra experiencia nos permite sortear obstáculos burocráticos para que su cadena de suministro nunca se detenga.
                    </p>
                    
                    <!-- Botones Inferiores apuntando a subpáginas -->
                    <div class="flex flex-wrap gap-4">
                        <a href="/servicios/carga-maritima" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Marítimo</a>
                        <a href="/servicios/carga-aerea" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Aéreo</a>
                        <a href="/servicios/carga-terrestre" class="border-2 border-[#BAD700] text-[#002845] font-medium py-2 px-6 rounded-full hover:bg-[#BAD700] hover:text-white transition-colors block text-center">Terrestre</a>
                    </div>
                </div>
                <div class="w-full md:w-1/3 flex flex-col gap-6 text-right">
                    <div>
                        <p class="text-5xl font-black text-[#002845]">15+</p>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mt-1">Años de experiencia logistica</p>
                    </div>
                    <div>
                        <p class="text-5xl font-black text-[#002845]">99%</p>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mt-1">Entregas a tiempo</p>
                    </div>
                    <div>
                        <p class="text-5xl font-black text-[#002845]">24/7</p>
                        <p class="text-xs text-gray-400 uppercase tracking-widest mt-1">Soporte aduanero especializado</p>
                    </div>
                </div>
            </div>
        </section>

      <!-- TESTIMONIOS -->
        <section class="py-24 px-6 bg-white">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-4xl md:text-5xl font-light text-[#002845] text-center mb-16">
                    <span class="text-[#BAD700] font-bold text-5xl mr-2">Q</span>Experiencias de <span class="font-black">Clientes</span>
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Tarjeta 1 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/3760370/pexels-photo-3760370.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Ejecutivo" class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Roberto Mendoza</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Importadora Sur C.A.</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"La gestión aduanera de Quality FS nos ahorró semanas de espera en el puerto. Su equipo se encargó de toda la documentación con una eficiencia que no habíamos visto antes con otros operadores."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>

                    <!-- Tarjeta 2 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/5805404/pexels-photo-5805404.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Supervisora Logística" class="w-full h-full object-cover object-top" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Elena Castillo</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Distribuciones Globales</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"Consolidar nuestra carga desde Asia siempre fue un dolor de cabeza hasta que empezamos a trabajar con ellos. El tracking es preciso y la atención es sumamente profesional en todo momento."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>

                    <!-- Tarjeta 3 -->
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 relative overflow-hidden group">
                        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-[#BAD700] rounded-full opacity-80 group-hover:scale-150 transition-transform duration-500"></div>
                        <div class="flex items-center gap-4 mb-4 relative z-10">
                            <div class="w-14 h-14 bg-gray-300 rounded-full overflow-hidden border-2 border-white shadow-sm">
                                <img src="https://images.pexels.com/photos/3184611/pexels-photo-3184611.jpeg?auto=compress&cs=tinysrgb&w=150" alt="Junta Directiva" class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <h4 class="font-black text-[#002845] leading-tight">Andrés Villalobos</h4>
                                <p class="text-[#BAD700] font-bold text-sm">Retail & Moda Express</p>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-4 relative z-10">"Utilizamos su servicio de carga aérea semanalmente. Las tarifas son inmejorables y la tranquilidad de saber que la mercancía llegará a los anaqueles a tiempo no tiene precio."</p>
                        <div class="flex text-[#BAD700] text-xl relative z-10">★★★★★</div>
                    </div>
                </div>
            </div>
        </section>

    </main>
    
    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>