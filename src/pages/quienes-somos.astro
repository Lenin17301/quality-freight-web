---
// src/pages/quienes-somos.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QEmblem from '../components/QEmblem.astro';

const schemaData = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Quiénes Somos | Quality Freight Service",
    "description": "Conozca nuestra misión, visión y valores. Somos expertos en transporte internacional y logística aduanera con más de 15 años de experiencia.",
    "inLanguage": "es",
    "mainEntity": {
        "@type": "Organization",
        "name": "Quality Freight Service, C.A.",
        "url": "https://qualityfs.com.ve",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Caracas",
            "addressCountry": "VE"
        }
    }
};
---

<BaseLayout 
    lang="es" 
    title="Quiénes Somos | Quality Freight Service" 
    description="Conozca nuestra misión, visión y valores. Somos expertos en transporte internacional y logística aduanera con más de 15 años de experiencia."
>
    <div slot="header">
        <Navbar lang="es" />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <main class="bg-white overflow-hidden pb-24">
        <!-- HEADER / HERO -->
        <section class="pt-32 pb-16 px-6 lg:pt-40 max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
            
            <div class="w-full lg:w-1/2 relative order-1 lg:order-1">
                <div class="absolute top-1/2 left-0 w-48 h-48 lg:w-72 lg:h-72 bg-[#002845] rounded-full opacity-10 -translate-y-1/2 -translate-x-1/4 pointer-events-none"></div>
                <div class="grid grid-cols-2 gap-3 lg:gap-4 relative z-10">
                    <img 
                        src="https://images.pexels.com/photos/6169046/pexels-photo-6169046.jpeg?auto=compress&cs=tinysrgb&w=600" 
                        alt="Transporte aéreo de carga internacional Quality Freight Service" 
                        width="600" 
                        height="400" 
                        fetchpriority="high"
                        loading="eager"
                        decoding="sync"
                        class="rounded-[1.5rem] lg:rounded-[2rem] w-full h-40 lg:h-56 object-cover col-span-2 shadow-lg" 
                    />
                    <img 
                        src="https://images.pexels.com/photos/1095814/pexels-photo-1095814.jpeg?auto=compress&cs=tinysrgb&w=400" 
                        alt="Buque portacontenedores en operación marítima" 
                        width="400" 
                        height="300" 
                        loading="eager"
                        decoding="async"
                        class="rounded-[1.5rem] lg:rounded-[2rem] w-full h-32 lg:h-48 object-cover shadow-lg" 
                    />
                    <img 
                        src="https://images.pexels.com/photos/2226458/pexels-photo-2226458.jpeg?auto=compress&cs=tinysrgb&w=400" 
                        alt="Transporte terrestre y distribución de mercancía" 
                        width="400" 
                        height="300" 
                        loading="eager"
                        decoding="async"
                        class="rounded-[1.5rem] lg:rounded-[2rem] w-full h-32 lg:h-48 object-cover shadow-lg" 
                    />
                </div>
            </div>

            <div class="w-full lg:w-1/2 order-2 lg:order-2 mt-8 lg:mt-0 text-center lg:text-left">
                <span class="text-[#BAD700] font-black tracking-[0.2em] uppercase text-xs block mb-3">
                    Nuestra Empresa
                </span>
                <h1 class="text-5xl md:text-6xl font-light text-[#002845] mb-6 leading-tight">
                    Quiénes <span class="font-black text-[#BAD700]">somos</span>
                </h1>
                <p class="text-gray-500 mb-10 leading-relaxed text-sm lg:text-base">
                    Somos una empresa especializada en transporte internacional de carga, comprometidos con ofrecer soluciones logísticas seguras, eficientes y adaptadas a las necesidades de cada cliente.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
                    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
                        <div class="w-12 h-12 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <h3 class="font-black text-[#002845] leading-tight mb-1">Cobertura<br/>Global</h3>
                        <p class="text-[11px] text-gray-500 leading-tight">Conectamos tu carga con el mundo.</p>
                    </div>
                    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
                        <div class="w-12 h-12 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        </div>
                        <h3 class="font-black text-[#002845] leading-tight mb-1">Seguridad<br/>Garantizada</h3>
                        <p class="text-[11px] text-gray-500 leading-tight">Protegemos tu carga en cada etapa.</p>
                    </div>
                    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
                        <div class="w-12 h-12 bg-[#BAD700] rounded-xl flex items-center justify-center mb-3 shadow-md">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        </div>
                        <h3 class="font-black text-[#002845] leading-tight mb-1">Compromiso<br/>con el cliente</h3>
                        <p class="text-[11px] text-gray-500 leading-tight">Tu éxito es nuestra prioridad.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- MISIÓN (Tarjeta Azul) -->
        <section class="px-6 mb-24">
            <div class="max-w-6xl mx-auto bg-[#002845] rounded-[3rem] overflow-hidden flex flex-col md:flex-row items-center shadow-2xl relative">
                <!-- Emblema decorativo de marca -->
                <div class="pointer-events-none select-none absolute -right-12 -bottom-12 opacity-10 z-0">
                    <QEmblem class="w-64 h-64 object-contain" decorative={true} widths={[256]} />
                </div>

                <div class="w-full md:w-1/2 h-64 md:h-96 relative z-10">
                    <img 
                        src="https://images.pexels.com/photos/1117210/pexels-photo-1117210.jpeg?auto=compress&cs=tinysrgb&w=800" 
                        alt="Operaciones portuarias y gestión logística integral - Misión Quality Freight Service" 
                        width="800" 
                        height="600" 
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover" 
                    />
                </div>
                <div class="w-full md:w-1/2 p-10 md:p-16 relative z-10">
                    <h2 class="text-4xl md:text-5xl font-light text-white mb-6">
                        Nuestra <span class="font-black text-[#BAD700]">Misión</span>
                    </h2>
                    <p class="text-stone-300 text-lg leading-relaxed">
                        Impulsar la evolución y el crecimiento de las empresas venezolanas por medio de servicios logísticos especializados, seguros y eficientes que optimizan su operación de extremo a extremo.
                    </p>
                </div>
            </div>
        </section>

        <!-- VALORES -->
        <section class="px-6 mb-24">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-4xl md:text-5xl font-light text-[#002845] text-center mb-12 leading-tight">
                    <QEmblem 
                        class="inline-block w-10 h-10 md:w-12 md:h-12 object-contain align-baseline mr-2 -mb-1" 
                        decorative={true} 
                        widths={[64, 96]} 
                    />Nuestros <span class="font-black text-[#BAD700]">Valores</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center flex flex-col items-center hover:-translate-y-2 transition-transform">
                        <h3 class="font-black text-[#002845] text-xl mb-3">Integridad</h3>
                        <p class="text-xs text-gray-500 leading-relaxed">Actuamos con honestidad y transparencia en cada operación aduanera y logística.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center flex flex-col items-center hover:-translate-y-2 transition-transform">
                        <h3 class="font-black text-[#002845] text-xl mb-3">Excelencia</h3>
                        <p class="text-xs text-gray-500 leading-relaxed">Buscamos la mejora continua para superar las expectativas del mercado logístico.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center flex flex-col items-center hover:-translate-y-2 transition-transform">
                        <h3 class="font-black text-[#002845] text-xl mb-3">Responsabilidad</h3>
                        <p class="text-xs text-gray-500 leading-relaxed">Cumplimos lo que prometemos, a tiempo, en forma y sin excusas.</p>
                    </div>
                    <div class="bg-[#E8ECEE] rounded-3xl p-8 text-center flex flex-col items-center hover:-translate-y-2 transition-transform">
                        <h3 class="font-black text-[#002845] text-xl mb-3">Trabajo en equipo</h3>
                        <p class="text-xs text-gray-500 leading-relaxed">Colaboramos estrechamente para ofrecer la mejor experiencia integral a su empresa.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div slot="footer">
        <Footer lang="es" />
    </div>
</BaseLayout>