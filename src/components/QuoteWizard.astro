---

<div
    class="qfs-quote-wizard relative z-10"
    data-quote-wizard
    data-lang={lang}
    data-uid={uid}
    data-strings={JSON.stringify(text)}
>
    <!-- Datalists de autocompletado -->
    <datalist id={`${uid}-countries`}>
        {countriesList.map((item) => <option value={item} />)}
    </datalist>
    <datalist id={`${uid}-ports`}>
        {portsList.map((item) => <option value={item} />)}
    </datalist>
    <datalist id={`${uid}-airports`}>
        {airportsList.map((item) => <option value={item} />)}
    </datalist>
    <datalist id={`${uid}-cities`}>
        {citiesList.map((item) => <option value={item} />)}
    </datalist>

    <!-- Barra de Progreso del Wizard -->
    <div class="mb-8" aria-label="Progreso de solicitud">
        <div class="flex items-center justify-between gap-2 mb-3" data-qw-stepper></div>
        <div class="w-full h-2 bg-[#E8ECEE] rounded-full overflow-hidden">
            <div data-qw-progress-bar class="h-full bg-[#BAD700] transition-all duration-300 rounded-full" style="width: 25%"></div>
        </div>
    </div>

    <!-- Iframe oculto para envío multipart con archivo MSDS adjunto sin recargar la página -->
    <iframe name={`${uid}-upload-frame`} data-qw-iframe class="hidden" title={text.iframeTitle}></iframe>

    <form
        action={`https://formsubmit.co/${destinationEmail}`}
        method="POST"
        enctype="multipart/form-data"
        data-ajax-url={`https://formsubmit.co/ajax/${destinationEmail}`}
        data-qw-form
        novalidate
        class="space-y-6"
    >
        <!-- Campos ocultos estructurados para FormSubmit -->
        <input type="hidden" name="_subject" value={text.subject} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />

        <input type="hidden" name="Ruta_Origen_Completa" data-qw-hidden-origin />
        <input type="hidden" name="Ruta_Destino_Completa" data-qw-hidden-dest />
        <input type="hidden" name="Incoterm_Aplicado" data-qw-hidden-incoterm />
        <input type="hidden" name="Modalidad_y_Equipo" data-qw-hidden-modality />
        <input type="hidden" name="Detalle_Medidas_y_Peso" data-qw-hidden-dimensions />
        <input type="hidden" name="Carga_Peligrosa_IMO" data-qw-hidden-imo />

        <!-- ========================================================= -->
        <!-- PASO 1: INFORMACIÓN PERSONAL                              -->
        <!-- ========================================================= -->
        <div data-qw-step="1" class="space-y-6">
            <div class="border-b border-stone-100 pb-4">
                <h3 class="text-xl font-black text-[#002845]">{text.s1Title}</h3>
                <p class="text-xs text-gray-500 mt-1">{text.s1Sub}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for={`${uid}-name`} class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">
                        {text.nameLabel} <span class="text-red-500">{text.requiredTag}</span>
                    </label>
                    <input
                        type="text"
                        id={`${uid}-name`}
                        name="Nombre_y_Apellido"
                        placeholder={text.namePh}
                        required
                        class="w-full bg-[#E8ECEE] border-2 border-transparent rounded-xl px-4 py-3 text-slate-700 focus:border-[#BAD700] focus:bg-white outline-none transition-all"
                    />
                </div>
                <div>
                    <label for={`${uid}-company`} class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">
                        {text.companyLabel} <span class="text-red-500">{text.requiredTag}</span>
                    </label>
                    <input
                        type="text"
                        id={`${uid}-company`}
                        name="Empresa"
                        placeholder={text.companyPh}
                        required
                        class="w-full bg-[#E8ECEE] border-2 border-transparent rounded-xl px-4 py-3 text-slate-700 focus:border-[#BAD700] focus:bg-white outline-none transition-all"
                    />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for={`${uid}-email`} class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">
                        {text.emailLabel} <span class="text-red-500">{text.requiredTag}</span>
                    </label>
                    <input
                        type="email"
                        id={`${uid}-email`}
                        name="email"
                        placeholder={text.emailPh}
                        required
                        class="w-full bg-[#E8ECEE] border-2 border-transparent rounded-xl px-4 py-3 text-slate-700 focus:border-[#BAD700] focus:bg-white outline-none transition-all"
                    />
                </div>
                <div>
                    <label for={`${uid}-phone`} class="block text-xs font-bold text-[#002845] mb-2 uppercase tracking-wide">
                        {text.phoneLabel} <span class="text-red-500">{text.requiredTag}</span>
                    </label>
                    <input
                        type="tel"
                        id={`${uid}-phone`}
                        name="Telefono"
                        placeholder={text.phonePh}
                        required
                        class="w-full bg-[#E8ECEE] border-2 border-transparent rounded-xl px-4 py-3 text-slate-700 focus:border-[#BAD700] focus:bg-white outline-none transition-all"
                    />
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- PASO 2: RUTA Y SERVICIOS                                  -->
        <!-- ========================================================= -->
        <div data-qw-step="2" class="hidden space-y-6">
            <div class="border-b border-stone-100 pb-4">
                <h3 class="text-xl font-black text-[#002845]">{text.s2Title}</h3>
                <p class="text-xs text-gray-500 mt-1">{text.s2Sub}</p>
            </div>

            <!-- 1. Modo de Transporte (Tarjetas visuales grandes) -->
            <div>
                <span class="block text-xs font-bold text-[#002845] mb-3 uppercase tracking-wide">
