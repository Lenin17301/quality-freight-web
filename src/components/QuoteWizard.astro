                            <svg class="w-8 h-8 text-[#002845] peer-checked:text-[#BAD700] group-has-[:checked]:text-[#BAD700] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
