---
// src/components/TeamCarousel.astro
interface TeamMember {
    id: string;
    name: string;
    role_es: string;
    role_en: string;
    photo?: string;
    active: boolean;
}

interface Props {
    members: TeamMember[];
    lang?: 'es' | 'en';
}

const { members = [], lang = 'es' } = Astro.props;

const getInitials = (name: string) => {
    return name
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase())
        .join('');
};

const labels = {
    prev: lang === 'es' ? 'Integrante anterior' : 'Previous team member',
    next: lang === 'es' ? 'Siguiente integrante' : 'Next team member',
    carousel: lang === 'es' ? 'Carrusel del equipo de trabajo' : 'Team members carousel',
    atCompany: lang === 'es' ? 'en Quality Freight Service' : 'at Quality Freight Service',
};
---

<div class="relative group/carousel" data-team-carousel>
    <!-- Botón Anterior -->
    <button
        type="button"
        data-carousel-prev
        aria-label={labels.prev}
        class="hidden md:flex items-center justify-center w-11 h-11 rounded-full bg-[#002845] text-white hover:bg-[#BAD700] hover:text-[#002845] shadow-lg transition-all duration-200 absolute -left-5 top-1/2 -translate-y-1/2 z-20 focus:outline-none focus:ring-2 focus:ring-[#BAD700] disabled:opacity-0 disabled:pointer-events-none"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
    </button>

    <!-- Pista desplazable del carrusel -->
    <div
        data-carousel-track
        role="region"
        aria-label={labels.carousel}
        tabindex="0"
        class="flex gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 px-1 no-scrollbar focus:outline-none"
    >
        {members.map((member) => {
            const role = lang === 'es' ? member.role_es : member.role_en;
            return (
                <article
                    data-carousel-slide
                    class="w-full sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] shrink-0 snap-start bg-[#E8ECEE]/70 border border-gray-100 rounded-3xl p-8 text-center flex flex-col items-center shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300"
                >
                    {member.photo ? (
                        <div class="w-32 h-32 rounded-full overflow-hidden mb-6 ring-4 ring-white shadow-md bg-[#002845]">
                            <img
                                src={member.photo}
                                alt={`${member.name} - ${role} ${labels.atCompany}`}
                                width="256"
                                height="256"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover object-top"
                            />
                        </div>
                    ) : (
                        <div
                            class="w-32 h-32 rounded-full mb-6 ring-4 ring-white shadow-md bg-gradient-to-br from-[#002845] to-[#003d66] flex items-center justify-center text-white select-none"
                            aria-hidden="true"
                        >
                            <span class="text-3xl font-black tracking-wider text-[#BAD700]">
                                {getInitials(member.name) || 'QF'}
                            </span>
                        </div>
                    )}

                    <h3 class="font-black text-[#002845] text-xl mb-2 leading-snug">
                        {member.name}
                    </h3>
                    <p class="text-xs font-bold uppercase tracking-wider text-[#002845]/80 bg-white px-4 py-1.5 rounded-full shadow-sm">
                        {role}
                    </p>
                </article>
            );
        })}
    </div>

    <!-- Botón Siguiente -->
    <button
        type="button"
        data-carousel-next
        aria-label={labels.next}
        class="hidden md:flex items-center justify-center w-11 h-11 rounded-full bg-[#002845] text-white hover:bg-[#BAD700] hover:text-[#002845] shadow-lg transition-all duration-200 absolute -right-5 top-1/2 -translate-y-1/2 z-20 focus:outline-none focus:ring-2 focus:ring-[#BAD700] disabled:opacity-0 disabled:pointer-events-none"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
    </button>

    <!-- Indicadores (puntos) y controles móviles -->
    <div class="flex items-center justify-center gap-3 mt-6" data-carousel-controls>
        <button
            type="button"
            data-carousel-prev-mobile
            aria-label={labels.prev}
            class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-[#E8ECEE] text-[#002845] hover:bg-[#BAD700] transition-colors"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <div data-carousel-dots class="flex items-center gap-2"></div>

        <button
            type="button"
            data-carousel-next-mobile
            aria-label={labels.next}
            class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-[#E8ECEE] text-[#002845] hover:bg-[#BAD700] transition-colors"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </div>
</div>

<style>
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    function initTeamCarousels() {
        const carousels = document.querySelectorAll<HTMLElement>('[data-team-carousel]');

        carousels.forEach((root) => {
            if (root.dataset.initialized === 'true') return;
            root.dataset.initialized = 'true';

            const track = root.querySelector<HTMLElement>('[data-carousel-track]');
            const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
            const prevBtns = root.querySelectorAll<HTMLButtonElement>('[data-carousel-prev], [data-carousel-prev-mobile]');
            const nextBtns = root.querySelectorAll<HTMLButtonElement>('[data-carousel-next], [data-carousel-next-mobile]');
            const dotsContainer = root.querySelector<HTMLElement>('[data-carousel-dots]');
            const controlsWrapper = root.querySelector<HTMLElement>('[data-carousel-controls]');

            if (!track || slides.length === 0) return;

            const getStepWidth = () => {
                const firstSlide = slides[0];
                const style = window.getComputedStyle(track);
                const gap = parseFloat(style.columnGap || style.gap || '32') || 32;
                return firstSlide.offsetWidth + gap;
            };

            const getVisibleCount = () => {
                if (window.innerWidth >= 1024) return 3;
                if (window.innerWidth >= 640) return 2;
                return 1;
            };

            const updateUI = () => {
                const visibleCount = getVisibleCount();
                const maxIndex = Math.max(0, slides.length - visibleCount);
                const hasOverflow = maxIndex > 0;

                prevBtns.forEach((btn) => (btn.disabled = !hasOverflow));
                nextBtns.forEach((btn) => (btn.disabled = !hasOverflow));
                if (controlsWrapper) {
                    controlsWrapper.style.display = hasOverflow ? 'flex' : 'none';
                }

                if (!dotsContainer) return;
                const step = getStepWidth();
                const currentIndex = Math.min(maxIndex, Math.round(track.scrollLeft / step));
                const totalStops = maxIndex + 1;

                dotsContainer.innerHTML = '';
                for (let i = 0; i < totalStops; i++) {
                    const dot = document.createElement('button');
                    dot.type = 'button';
                    dot.setAttribute('aria-label', `Slide ${i + 1}`);
                    const isActive = i === currentIndex;
                    dot.className = isActive
                        ? 'w-7 h-2.5 rounded-full bg-[#BAD700] transition-all duration-300'
                        : 'w-2.5 h-2.5 rounded-full bg-[#002845]/25 hover:bg-[#002845]/50 transition-all duration-300';
                    dot.addEventListener('click', () => {
                        track.scrollTo({ left: i * step, behavior: 'smooth' });
                    });
                    dotsContainer.appendChild(dot);
                }
            };

            const scrollByStep = (direction: number) => {
                const step = getStepWidth();
                const visibleCount = getVisibleCount();
                const maxIndex = Math.max(0, slides.length - visibleCount);
                const currentIndex = Math.round(track.scrollLeft / step);
                let targetIndex = currentIndex + direction;

                if (targetIndex > maxIndex) targetIndex = 0;
                if (targetIndex < 0) targetIndex = maxIndex;

                track.scrollTo({ left: targetIndex * step, behavior: 'smooth' });
            };

            prevBtns.forEach((btn) => btn.addEventListener('click', () => scrollByStep(-1)));
            nextBtns.forEach((btn) => btn.addEventListener('click', () => scrollByStep(1)));

            track.addEventListener('scroll', () => {
                window.requestAnimationFrame(updateUI);
            }, { passive: true });

            window.addEventListener('resize', updateUI);
            updateUI();
        });
    }

    initTeamCarousels();
    document.addEventListener('astro:page-load', initTeamCarousels);
</script>