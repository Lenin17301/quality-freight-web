---
// src/components/Footer.astro
const { lang } = Astro.props;

const content = {
    es: {
        about: "Quality Freight Service, C.A. es su aliado estratégico en soluciones logísticas globales, garantizando seguridad y eficiencia en cada envío.",
        links: [
            { name: "Inicio", url: "/" },
            { name: "Quiénes somos", url: "/quienes-somos" },
            { name: "Servicios", url: "/servicios" },
            { name: "Asesoría", url: "/asesoria" },
            { name: "Rastreo", url: "/rastreo" }
        ],
        contact: "Contacto",
        address: "Caracas, Venezuela",
        rights: "© 2026 Quality Freight Service. Todos los derechos reservados."
    },
    en: {
        about: "Quality Freight Service, C.A. is your strategic partner in global logistics solutions, ensuring security and efficiency in every shipment.",
        links: [
            { name: "Home", url: "/en/" },
            { name: "About us", url: "/en/about" },
            { name: "Services", url: "/en/services" },
            { name: "Consulting", url: "/en/consulting" },
            { name: "Tracking", url: "/en/tracking" }
        ],
        contact: "Contact",
        address: "Caracas, Venezuela",
        rights: "© 2026 Quality Freight Service. All rights reserved."
    }
};

const t = content[lang] || content.es;
---

<footer class="bg-[#002845] text-white pt-20 pb-10 px-6 rounded-t-[3rem] mt-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
        
        <!-- Logo y descripción -->
        <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-6">
                <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center relative overflow-hidden">
                    <span class="text-[#002845] font-black text-xl relative z-10">Q</span>
                    <div class="absolute bottom-0 right-0 w-4 h-4 bg-[#BAD700] rounded-tl-full"></div>
                </div>
                <span class="font-bold text-xl tracking-tight">Quality Freight</span>
            </div>
            <p class="text-stone-400 text-sm max-w-sm leading-relaxed">{t.about}</p>
        </div>

        <!-- Links -->
        <div>
            <h4 class="font-black text-[#BAD700] mb-6 uppercase tracking-widest text-sm">Navegación</h4>
            <ul class="space-y-4">
                {t.links.map(link => (
                    <li><a href={link.url} class="text-stone-300 hover:text-[#BAD700] transition-colors">{link.name}</a></li>
                ))}
            </ul>
        </div>

        <!-- Contacto -->
        <div>
            <h4 class="font-black text-[#BAD700] mb-6 uppercase tracking-widest text-sm">{t.contact}</h4>
            <ul class="space-y-4 text-stone-300 text-sm">
                <li>📍 {t.address}</li>
                <li>📧 info@qualityfs.com.ve</li>
                <li>📞 +58 212 555 0000</li>
            </ul>
        </div>
    </div>

    <!-- Barra inferior -->
    <div class="max-w-7xl mx-auto border-t border-[#BAD700]/20 pt-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-stone-500 text-xs">{t.rights}</p>
        <div class="flex gap-6">
            <!-- NOTA: Aquí puedes poner tus rutas de privacidad cuando las tengas -->
            <a href="#" class="text-stone-400 hover:text-white transition-colors text-xs">Política de Privacidad</a>
            <a href="#" class="text-stone-400 hover:text-white transition-colors text-xs">Términos de Servicio</a>
        </div>
    </div>
</footer>