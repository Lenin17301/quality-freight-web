---
// src/components/Footer.astro
import QEmblem from './QEmblem.astro';

const { lang = 'es' } = Astro.props;

const content = {
    es: {
        homeAria: "Ir al inicio - Quality Freight Service",
        about: "Quality Freight Service, C.A. es su aliado estratégico en soluciones logísticas globales, garantizando seguridad y eficiencia en cada envío.",
        navTitle: "Navegación",
        links: [
            { name: "Inicio", url: "/" },
            { name: "Quiénes somos", url: "/quienes-somos" },
            { name: "Servicios", url: "/servicios/" },
            { name: "Asesoría", url: "/asesoria" },
            { name: "InfoQuality", url: "/infoquality" },
            { name: "Blog", url: "/blog" }
        ],
        contact: "Contacto",
        address: "Caracas, Venezuela",
        rights: "© 2026 Quality Freight Service. Todos los derechos reservados.",
        privacy: "Política de Privacidad",
        terms: "Términos de Servicio"
    },
    en: {
        homeAria: "Go to home - Quality Freight Service",
        about: "Quality Freight Service, C.A. is your strategic partner in global logistics solutions, ensuring security and efficiency in every shipment.",
        navTitle: "Navigation",
        links: [
            { name: "Home", url: "/en/" },
            { name: "About us", url: "/en/about" },
            { name: "Services", url: "/en/services/" },
            { name: "Consulting", url: "/en/consulting" },
            { name: "InfoQuality", url: "/en/infoquality" },
            { name: "Blog", url: "/en/blog" }
        ],
        contact: "Contact",
        address: "Caracas, Venezuela",
        rights: "© 2026 Quality Freight Service. All rights reserved.",
        privacy: "Privacy Policy",
        terms: "Terms of Service"
    }
};

const t = content[lang] || content.es;
---

<footer class="bg-[#002845] text-white pt-20 pb-10 px-6 rounded-t-[3rem] mt-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
        
        <!-- Logo y descripción -->
        <div class="md:col-span-2">
            <a href={lang === 'es' ? '/' : '/en/'} aria-label={t.homeAria} class="inline-flex items-center gap-3 mb-6 group">
                <QEmblem 
                    class="w-11 h-11 object-contain group-hover:scale-105 transition-transform duration-300" 
                    decorative={false} 
                    widths={[88, 132]}
                />
                <span class="font-bold text-xl tracking-tight text-white">Quality Freight</span>
            </a>
            <p class="text-stone-400 text-sm max-w-sm leading-relaxed">{t.about}</p>
        </div>

        <!-- Links -->
        <div>
            <h3 class="font-black text-[#BAD700] mb-6 uppercase tracking-widest text-sm">{t.navTitle}</h3>
            <ul class="space-y-4">
                {t.links.map(link => (
                    <li><a href={link.url} class="text-stone-300 hover:text-[#BAD700] transition-colors">{link.name}</a></li>
                ))}
            </ul>
        </div>

        <!-- Contacto -->
        <div>
            <h3 class="font-black text-[#BAD700] mb-6 uppercase tracking-widest text-sm">{t.contact}</h3>
            <ul class="space-y-4 text-stone-300 text-sm">
                <li>📍 {t.address}</li>
                <li>
                    <a href="mailto:info@qualityfs.com.ve" class="hover:text-[#BAD700] transition-colors">
                        📧 info@qualityfs.com.ve
                    </a>
                </li>
                <li>
                    <a href="tel:+582127622692" class="hover:text-[#BAD700] transition-colors">
                        📞 +58 212.762.26.92
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Barra inferior -->
    <div class="max-w-7xl mx-auto border-t border-[#BAD700]/20 pt-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-stone-500 text-xs">{t.rights}</p>
        <div class="flex gap-6">
            <a href="#" class="text-stone-400 hover:text-white transition-colors text-xs">{t.privacy}</a>
            <a href="#" class="text-stone-400 hover:text-white transition-colors text-xs">{t.terms}</a>
        </div>
    </div>
</footer>